<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <WindowsPackageType>None</WindowsPackageType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>局域网设备助手</AssemblyName>
    <RootNamespace>LanDeviceMonitor</RootNamespace>
    <Product>局域网设备助手</Product>
    <AssemblyTitle>局域网设备助手</AssemblyTitle>
    <Description>小米路由器局域网设备状态、流量、历史与上下线提醒工具</Description>
    <Version>0.1.17-beta.2</Version>
    <InformationalVersion>0.1.17-beta.2</InformationalVersion>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <Target Name="BuildNativeTray" BeforeTargets="PrepareForBuild"
          Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="$(MSBuildProjectDirectory)\Native\TrayRuntime.cpp;$(MSBuildProjectDirectory)\..\..\scripts\build-native-tray.ps1"
          Outputs="$(MSBuildProjectDirectory)\..\..\.tools\native-tray\LanDeviceMonitor.TrayRuntime.dll">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\build-native-tray.ps1&quot;" />
  </Target>
  <ItemGroup>
    <Content Include="..\..\.tools\native-tray\LanDeviceMonitor.TrayRuntime.dll" Link="LanDeviceMonitor.TrayRuntime.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260710003" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Web\**\*" Exclude="Web\fonts\*.woff2" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="Web\fonts\*.woff2">
      <LogicalName>LanDeviceMonitor.Web.Fonts.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>LanDeviceMonitor.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\AppIcon.png" />
    <Content Include="Assets\AppIcon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Remove="Assets\SystemIcon.ico" />
    <Resource Include="Assets\SystemIcon.ico" />
    <Content Include="Assets\SystemIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Remove="Assets\SystemIcon.png" />
    <Content Include="Assets\SystemIcon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Remove="Assets\ExecutableIcon.png" />
    <Content Include="Assets\ExecutableIcon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <None Remove="Assets\Fonts\*.otf;Assets\Fonts\*.ttf" />
    <Resource Include="Assets\Fonts\*.otf;Assets\Fonts\*.ttf" />
    <Content Include="Assets\Fonts\NotoSansSC-OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup><Content Include="ThirdParty\react-desktop\LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>


  <ItemGroup><Content Include="ThirdParty\lucide\LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><Content Include="ThirdParty\octicons\LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup>
    <Content Include="ThirdParty\retray\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="ThirdParty\echarts\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
