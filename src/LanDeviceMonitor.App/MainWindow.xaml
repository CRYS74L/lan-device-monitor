                                </Border>

                                <Grid Margin="18,0,18,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Background="{DynamicResource TimelineDurationBrush}"
                                            BorderBrush="{DynamicResource TimelineItemBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Margin="0,0,4,0"
                                            Padding="9,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Viewbox Width="20" Height="20"
                                                     VerticalAlignment="Center">
                                                <Path x:Name="DownloadRateArrow"
                                                      Data="{StaticResource TrafficRateArrowGeometry}"
