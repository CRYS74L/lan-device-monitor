<Window x:Class="LanDeviceMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="局域网设备助手"
        Width="1180" Height="760"
        MinWidth="980" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Grid x:Name="WindowRoot" Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SurfaceStrongBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="42" Height="42"
                           Source="Assets/AppIcon.png"
                           Stretch="Uniform"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="局域网设备助手" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="小米路由器设备状态与提醒" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource QuietButtonStyle}"
                            Height="32" MinHeight="32" MinWidth="86" Padding="12,4"
                            Margin="0,0,8,0"
                            Click="RouterButton_Click" ToolTip="查看上网信息与路由器操作">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8CE;" FontFamily="Segoe Fluent Icons"
                                       FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="路由器" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource QuietButtonStyle}"
                            Height="32" MinHeight="32" MinWidth="78" Padding="12,4"
                            Click="SettingsButton_Click" ToolTip="连接设置">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons"
                                       FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="设置" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="370"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <TextBlock Text="设备" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LastRefreshText" Text="等待连接" FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,16,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource OnlineCardBrush}" CornerRadius="9" Padding="14,10" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="在线设备" Foreground="{DynamicResource StatusOnlineTextBrush}" FontSize="12"/>
                                <TextBlock x:Name="OnlineCountText" Text="0" FontSize="24" FontWeight="SemiBold"
                                           Foreground="{DynamicResource StatusOnlineTextBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{DynamicResource OfflineCardBrush}" CornerRadius="9" Padding="14,10" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="离线设备" Foreground="{DynamicResource StatusOfflineTextBrush}" FontSize="12"/>
                                <TextBlock x:Name="OfflineCountText" Text="0" FontSize="24" FontWeight="SemiBold"
                                           Foreground="{DynamicResource StatusOfflineTextBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <ListBox x:Name="DeviceList" Grid.Row="2"
                             BorderThickness="0" Background="Transparent"
                             FocusVisualStyle="{x:Null}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseLeftButtonDown="DeviceList_PreviewMouseLeftButtonDown"
                             SelectionChanged="DeviceList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,7"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" Background="{DynamicResource ListItemBrush}"
                                                    BorderBrush="Transparent" BorderThickness="1"
                                                    CornerRadius="11" Padding="10,9">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#8BA4BCFF"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ListItemHoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="42" Height="42" CornerRadius="10" Background="#EEF2F8">
                                        <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe Fluent Icons"
                                                   FontSize="21" Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding ConnectionText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding IpAddress, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Width="58"
                                                VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <Border x:Name="StatusBadge" Width="48" Height="22"
                                                HorizontalAlignment="Right"
                                                Background="{DynamicResource StatusOfflineBrush}" CornerRadius="11">
                                            <TextBlock x:Name="StatusTextBlock"
                                                       Text="{Binding StatusText}" FontSize="11"
                                                       Foreground="{DynamicResource StatusOfflineTextBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding DownloadSpeedText}" FontSize="11"
                                                   Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0"
                                                   HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                        <Setter TargetName="StatusBadge" Property="Background" Value="{DynamicResource StatusOnlineBrush}"/>
                                        <Setter TargetName="StatusTextBlock" Property="Foreground" Value="{DynamicResource StatusOnlineTextBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="86" Height="86" CornerRadius="26" Background="#CFE8EEF9">
                            <TextBlock Text="&#xE8CE;" FontFamily="Segoe Fluent Icons" FontSize="40"
                                       Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="选择一台设备查看详情" FontSize="18" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,18,0,6"/>
                        <TextBlock Text="实时网速、累计用量和上下线历史将在这里显示"
                                   Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer x:Name="DetailPanel" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,24,28,36">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="74"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="64" Height="64" CornerRadius="16" Background="{StaticResource AccentLightBrush}">
                                <TextBlock Text="{Binding SelectedDevice.IconGlyph}" FontFamily="Segoe Fluent Icons"
                                           FontSize="31" Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedDevice.DisplayName}" FontSize="26" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SelectedDevice.LastSeenText}" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="2" x:Name="DetailStatusBadge" CornerRadius="10" Padding="12,6"
                                    VerticalAlignment="Center" Background="#E4E7EC">
                                <TextBlock x:Name="DetailStatusText" Text="离线" FontWeight="SemiBold" Foreground="#6B7280"/>
                            </Border>
                        </Grid>

                        <Grid Margin="0,22,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="下载速度" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding SelectedDevice.DownloadSpeedText}" FontSize="24" FontWeight="SemiBold" Margin="0,7,0,0"/>
                                    <TextBlock Text="实时" Foreground="{StaticResource AccentBrush}" FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="6,0">
                                <StackPanel>
                                    <TextBlock Text="上传速度" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding SelectedDevice.UploadSpeedText}" FontSize="24" FontWeight="SemiBold" Margin="0,7,0,0"/>
                                    <TextBlock Text="实时" Foreground="{StaticResource AccentBrush}" FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="累计用量" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding SelectedDevice.TotalUsageText}" FontSize="24" FontWeight="SemiBold" Margin="0,7,0,0"/>
                                    <TextBlock Text="路由器统计" Foreground="{StaticResource AccentBrush}" FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="连接方式" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                                    <TextBlock Text="{Binding SelectedDevice.ConnectionText}" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="IP 地址" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                                    <TextBlock Text="{Binding SelectedDevice.IpAddress}" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="累计下载" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                                    <TextBlock Text="{Binding SelectedDevice.TotalDownloadText}" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="累计上传" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                                    <TextBlock Text="{Binding SelectedDevice.TotalUploadText}" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="设备设置" FontSize="18" FontWeight="SemiBold" Margin="0,25,0,11"/>
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="自定义名称" FontWeight="SemiBold"
                                           Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="设备类型与图标"
                                           FontWeight="SemiBold" Margin="10,0,0,0"/>

                                <TextBox x:Name="CustomNameBox"
                                         Grid.Row="1"
                                         Height="48"
                                         Margin="0,8,10,0"
                                         TextChanged="DeviceNameBox_TextChanged"/>
                                <ComboBox x:Name="DeviceTypeCombo"
                                          Grid.Row="1" Grid.Column="1"
                                          Height="48"
                                          Margin="10,8,0,0"
                                          SelectionChanged="DeviceProfileControl_Changed">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="26" Height="26" CornerRadius="7"
                                                        Background="{StaticResource AccentLightBrush}"
                                                        Margin="0,0,9,0">
                                                    <TextBlock Text="{Binding IconGlyph}"
                                                               FontFamily="Segoe Fluent Icons"
                                                               FontSize="14"
                                                               Foreground="{StaticResource AccentBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding TypeName}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Grid.Row="2"
                                           Text="留空时使用自动识别名称"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="11" Margin="0,6,10,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="1"
                                           Text="可随时调整实际类型和对应图标"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="11" Margin="10,6,0,0"/>

                                <Border Grid.Row="3" Grid.ColumnSpan="2"
                                        Height="1"
                                        Background="{StaticResource BorderBrush}"
                                        Margin="0,15,0,14"/>

                                <StackPanel Grid.Row="4" Grid.ColumnSpan="2">
                                    <CheckBox x:Name="NotifyOnlineCheck"
                                              Content="设备上线时发送 Windows 系统通知"
                                              Margin="0,0,0,9"
                                              Checked="DeviceProfileControl_Changed"
                                              Unchecked="DeviceProfileControl_Changed"/>
                                    <Grid>
                                        <CheckBox x:Name="NotifyOfflineCheck"
                                                  Content="设备离线时发送 Windows 系统通知"
                                                  Checked="DeviceProfileControl_Changed"
                                                  Unchecked="DeviceProfileControl_Changed"/>
                                        <TextBlock x:Name="AutoSaveStatusText"
                                                   Text="修改会自动保存"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="11"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="上下线历史" FontSize="18" FontWeight="SemiBold" Margin="0,25,0,11"/>
                        <Border Style="{StaticResource CardStyle}">
                            <ItemsControl ItemsSource="{Binding SelectedDevice.Sessions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#70F5F7FB"
                                                BorderBrush="#70DCE2EC"
                                                BorderThickness="1"
                                                CornerRadius="11"
                                                Padding="12,10"
                                                Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="12" Margin="0,4,0,4">
                                                <Border Width="2" Background="#A3B3C9"
                                                        HorizontalAlignment="Center"
                                                        Margin="0,6,0,6"/>
                                                <Ellipse Width="9" Height="9" Fill="{StaticResource AccentBrush}"
                                                         VerticalAlignment="Top"/>
                                                <Ellipse Width="9" Height="9" Fill="#97A4B7"
                                                         VerticalAlignment="Bottom"/>
                                            </Grid>
                                            <StackPanel Grid.Column="1">
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="62"/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="上线时间" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding OnlineAtText}" FontWeight="SemiBold"/>
                                                </Grid>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="62"/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="离线时间" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding OfflineAtText}" FontWeight="SemiBold"/>
                                                </Grid>
                                            </StackPanel>
                                            <Border Grid.Column="2" Background="#DCE8EDF5" CornerRadius="9"
                                                    Padding="9,5" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DurationText}" FontSize="11"/>
                                            </Border>
                                        </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="RouterPanel" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="32,28,32,40">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="路由器与上网信息"
                                           FontSize="28" FontWeight="SemiBold"/>
                                <TextBlock Text="查看 IPv4、IPv6 连接信息并管理路由器"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Button x:Name="RefreshRouterInfoButton"
                                        Content="刷新"
                                        Style="{StaticResource QuietButtonStyle}"
                                        MinHeight="32" Height="32" Padding="12,4"
                                        Click="RefreshRouterInfoButton_Click"
                                        Margin="0,0,8,0"/>
                                <Button Content="返回设备"
                                        Style="{StaticResource QuietButtonStyle}"
                                        MinHeight="32" Height="32" Padding="12,4"
                                        Click="BackFromRouterButton_Click"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,22,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="上网信息" FontSize="18" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <Border x:Name="RouterConnectionBadge"
                                    Grid.Column="1"
                                    Background="#DDF5E8"
                                    CornerRadius="10"
                                    Padding="11,5">
                                <TextBlock x:Name="RouterConnectionBadgeText"
                                           Text="正在读取"
                                           Foreground="#14794A"
                                           FontWeight="SemiBold"
                                           FontSize="11"/>
                            </Border>
                        </Grid>

                        <Border x:Name="RouterInfoLoadingBorder"
                                Background="#DDE9EEFF"
                                BorderBrush="#8FA8BEFF"
                                BorderThickness="1"
                                CornerRadius="11"
                                Padding="12,9"
                                Margin="0,12,0,0">
                            <TextBlock x:Name="RouterInfoLoadingText"
                                       Text="正在读取上网信息…"
                                       Foreground="{StaticResource AccentBrush}"/>
                        </Border>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource CardStyle}"
                                    Margin="0,0,7,0">
                                <StackPanel>
                                    <TextBlock Text="IPv4 信息"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,16"/>
                                    <Grid Margin="0,0,0,11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="84"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="连接类型" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock x:Name="Ipv4TypeText" Grid.Column="1" Text="—" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="84"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="IP 地址" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock x:Name="Ipv4AddressText" Grid.Column="1" Text="—" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="84"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="子网掩码" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock x:Name="Ipv4MaskText" Grid.Column="1" Text="—" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="84"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="默认网关" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock x:Name="Ipv4GatewayText" Grid.Column="1" Text="—" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="84"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="DNS" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock x:Name="Ipv4DnsText" Grid.Column="1" Text="—" FontWeight="SemiBold"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1"
                                    Style="{StaticResource CardStyle}"
                                    Margin="7,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="IPv6 信息"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,16"/>
                                    <Grid Margin="0,0,0,11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="102"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="连接类型" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock x:Name="Ipv6TypeText" Grid.Column="1" Text="—" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="102"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="WAN IPv6 地址" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock x:Name="WanIpv6AddressText" Grid.Column="1" Text="—"
                                                   FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="102"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="WAN IPv6 网关" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock x:Name="WanIpv6GatewayText" Grid.Column="1" Text="—"
                                                   FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="102"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="LAN IPv6 地址" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock x:Name="LanIpv6AddressText" Grid.Column="1" Text="—"
                                                   FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="102"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="LAN IPv6 前缀" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock x:Name="LanIpv6PrefixText" Grid.Column="1" Text="—"
                                                   FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="102"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="DNS" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock x:Name="Ipv6DnsText" Grid.Column="1" Text="—"
                                                   FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock Text="Mesh 网络节点"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,24,0,11"/>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="每个数字表示当前直接连接到该节点的设备数量"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="11"
                                           Margin="0,0,0,12"/>
                                <TextBlock x:Name="MeshNodesEmptyText"
                                           Text="当前路由器没有返回 Mesh 节点信息"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Visibility="Collapsed"/>
                                <ItemsControl x:Name="MeshNodesItemsControl">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="270"
                                                    MinHeight="104"
                                                    Background="{DynamicResource ListItemBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="13"
                                                    Padding="13"
                                                    Margin="0,0,10,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="46"/>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition Width="42"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="40" Height="40"
                                                            CornerRadius="11"
                                                            Background="{DynamicResource AccentLightBrush}"
                                                            VerticalAlignment="Top">
                                                        <TextBlock Text="&#xE8CE;"
                                                                   FontFamily="Segoe Fluent Icons"
                                                                   FontSize="18"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1"
                                                                Margin="0,0,8,0"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="14"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding ConnectionText}"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   FontSize="11"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,4,0,0"/>
                                                        <TextBlock Text="{Binding IpAddress}"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   FontSize="11"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,2,0,0"/>
                                                        <TextBlock Text="{Binding Hardware}"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   FontSize="11"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2"
                                                            Width="34"
                                                            Height="34"
                                                            CornerRadius="17"
                                                            Background="{DynamicResource AccentBrush}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ConnectedDeviceCount}"
                                                                   Foreground="White"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="14"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="路由器操作" FontSize="18" FontWeight="SemiBold"
                                   Margin="0,24,0,11"/>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="11"
                                            Background="#FFF0F0">
                                        <TextBlock Text="&#xE777;" FontFamily="Segoe Fluent Icons"
                                                   FontSize="18" Foreground="#C4362E"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="重启路由器" FontWeight="SemiBold"/>
                                        <TextBlock Text="重启期间设备会暂时断网，应用会持续显示恢复进度"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="11" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="RestartRouterButton"
                                            Grid.Column="2"
                                            Content="重启路由器"
                                            Background="#FDECEC"
                                            Foreground="#B42318"
                                            MinHeight="34" Height="34"
                                            Padding="13,5"
                                            Click="RestartRouterButton_Click"/>
                                </Grid>

                                <Border x:Name="RestartConfirmBorder"
                                        Visibility="Collapsed"
                                        Background="#FFFFF4E5"
                                        BorderBrush="#F4C982"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12"
                                        Margin="0,14,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="确认现在重启？所有设备会暂时失去网络连接。"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="取消"
                                                    Style="{StaticResource QuietButtonStyle}"
                                                    MinHeight="30" Height="30" Padding="11,3"
                                                    Click="CancelRestartButton_Click"
                                                    Margin="0,0,7,0"/>
                                            <Button Content="确认重启"
                                                    Background="#C4362E" Foreground="White"
                                                    MinHeight="30" Height="30" Padding="11,3"
                                                    Click="ConfirmRestartButton_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border x:Name="RouterRestartProgressBorder"
                                        Visibility="Collapsed"
                                        Background="#DDEBF1FF"
                                        CornerRadius="10"
                                        Padding="12"
                                        Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="RouterRestartStatusText"
                                                   Text="正在准备重启…"
                                                   FontWeight="SemiBold"/>
                                        <ProgressBar x:Name="RouterRestartProgressBar"
                                                     IsIndeterminate="True"
                                                     Height="5"
                                                     Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="42,36" Width="620" HorizontalAlignment="Left">
                        <TextBlock Text="设置" FontSize="28" FontWeight="SemiBold"/>
                        <TextBlock Text="全部设置都会在修改后自动应用。"
                                   Foreground="{DynamicResource MutedTextBrush}" Margin="0,7,0,22"/>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="路由器地址" FontWeight="SemiBold"/>
                                <TextBox x:Name="RouterAddressBox" Margin="0,8,0,16"
                                         TextChanged="RouterConnectionSetting_Changed"/>
                                <TextBlock Text="管理员密码" FontWeight="SemiBold"/>
                                <PasswordBox x:Name="RouterPasswordBox" Margin="0,8,0,4"
                                             PasswordChanged="RouterConnectionSetting_Changed"/>
                                <TextBlock Text="已保存密码时可留空；填写后会覆盖已有凭据。"
                                           Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/>
                                <TextBlock Text="刷新间隔（秒）" FontWeight="SemiBold" Margin="0,16,0,0"/>
                                <ComboBox x:Name="RefreshIntervalCombo"
                                          Margin="0,8,0,0"
                                          Width="150"
                                          HorizontalAlignment="Left"
                                          SelectionChanged="AppBehaviorSetting_Changed">
                                    <ComboBoxItem Content="2"/>
                                    <ComboBoxItem Content="3"/>
                                    <ComboBoxItem Content="5"/>
                                    <ComboBoxItem Content="10"/>
                                </ComboBox>
                                <TextBlock Text="界面主题" FontWeight="SemiBold" Margin="0,16,0,0"/>
                                <ComboBox x:Name="ThemeModeCombo"
                                          Margin="0,8,0,0"
                                          Width="180"
                                          HorizontalAlignment="Left"
                                          SelectionChanged="AppBehaviorSetting_Changed">
                                    <ComboBoxItem Content="跟随系统" Tag="System"/>
                                    <ComboBoxItem Content="浅色模式" Tag="Light"/>
                                    <ComboBoxItem Content="深色模式" Tag="Dark"/>
                                </ComboBox>
                                <CheckBox x:Name="CloseToTrayCheck" Content="关闭窗口时继续在系统托盘监控"
                                          Margin="0,18,0,0"
                                          Checked="AppBehaviorSetting_Changed"
                                          Unchecked="AppBehaviorSetting_Changed"/>
                                <CheckBox x:Name="StartWithWindowsCheck"
                                          Content="登录 Windows 后自动启动此应用"
                                          Margin="0,12,0,0"
                                          Checked="AppBehaviorSetting_Changed"
                                          Unchecked="AppBehaviorSetting_Changed"/>
                                <TextBlock x:Name="AppSettingsAutoSaveText"
                                           Text="修改会自动保存"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="11"
                                           HorizontalAlignment="Right"
                                           Margin="0,8,0,0"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                                    <Button Content="返回" Style="{StaticResource QuietButtonStyle}"
                                            Click="CancelSettingsButton_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border x:Name="SettingsMessageBorder" Visibility="Collapsed"
                                Background="#FFF4E5" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                            <TextBlock x:Name="SettingsMessageText" Foreground="#8A4B08" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="ConnectionDot" Width="7" Height="7" Fill="#9CA3AF"/>
                    <TextBlock x:Name="ConnectionStatusText" Text="尚未连接" FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}" Margin="7,0,0,0"/>
                </StackPanel>
                <TextBlock Text="数据仅保存在本机" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
