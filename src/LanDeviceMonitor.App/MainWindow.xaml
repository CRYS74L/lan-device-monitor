                                                Height="38"
                                                CornerRadius="12"
                                                Background="{DynamicResource TimelineDurationBrush}"
                                                BorderBrush="{DynamicResource TimelineItemBorderBrush}"
                                                BorderThickness="1">
                                            <Viewbox Width="23" Height="23"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center">
                                                <Path Data="M19.46 10a1 1 0 0 0-.07 1 7.55 7.55 0 0 1 .52 1.81 8 8 0 0 1-.69 4.73 1 1 0 0 1-.89.53H5.68a1 1 0 0 1-.89-.54A8 8 0 0 1 13 6.06a7.69 7.69 0 0 1 2.11.56 1 1 0 0 0 1-.07 1 1 0 0 0-.17-1.76A10 10 0 0 0 3.35 19a2 2 0 0 0 1.72 1h13.85a2 2 0 0 0 1.74-1 10 10 0 0 0 .55-8.89 1 1 0 0 0-1.75-.11 M10.59 12.59a2 2 0 0 0 2.83 2.83l5.66-8.49z"
                                                      Fill="{DynamicResource TrafficUploadBrush}"/>
                                            </Viewbox>
                                        </Border>
                                        <TextBlock Text="流量统计"
                                                   FontSize="20"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button x:Name="TrafficRangeButton"
                                            Grid.Column="1"
                                            Style="{StaticResource TimelineDurationButtonStyle}"
