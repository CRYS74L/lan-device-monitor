<Window x:Class="LanDeviceMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="局域网设备助手"
        Width="1180" Height="760"
        MinWidth="980" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Grid Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceStrongBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="10" Background="Transparent">
                        <Border Background="{StaticResource AccentBrush}" CornerRadius="10">
                            <TextBlock Text="&#xE8CE;" FontFamily="Segoe Fluent Icons"
                                       Foreground="White" FontSize="19"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="局域网设备助手" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="小米路由器设备状态与提醒" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource QuietButtonStyle}"
                        Click="SettingsButton_Click" ToolTip="连接设置">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" Margin="0,0,7,0"/>
                        <TextBlock Text="设置"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="370"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#CFF9FBFE"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <TextBlock Text="设备" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LastRefreshText" Text="等待连接" FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,16,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#EDF8F1" CornerRadius="9" Padding="14,10" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="在线设备" Foreground="#47735A" FontSize="11"/>
                                <TextBlock x:Name="OnlineCountText" Text="0" FontSize="24" FontWeight="SemiBold" Foreground="#16794A"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#F2F3F6" CornerRadius="9" Padding="14,10" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="离线设备" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                                <TextBlock x:Name="OfflineCountText" Text="0" FontSize="24" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"
                                   IsHitTestVisible="False"/>
                        <TextBox x:Name="SearchBox" Padding="36,9,12,9"
                                 ToolTip="搜索名称、IP 或 MAC 地址"
                                 TextChanged="SearchBox_TextChanged"/>
                    </Grid>

                    <ListBox x:Name="DeviceList" Grid.Row="3"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="DeviceList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,7"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" Background="#50FFFFFF"
                                                    BorderBrush="Transparent" BorderThickness="1"
                                                    CornerRadius="11" Padding="10,9">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentLightBrush}"/>
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#8BA4BCFF"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#B8F0F3F8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="42" Height="42" CornerRadius="10" Background="#EEF2F8">
                                        <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe Fluent Icons"
                                                   FontSize="21" Foreground="{StaticResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                                   TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding ConnectionText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding IpAddress, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <Border x:Name="StatusBadge" Background="#E4E7EC" CornerRadius="8" Padding="7,2">
                                            <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="#6B7280"/>
                                        </Border>
                                        <TextBlock Text="{Binding DownloadSpeedText}" FontSize="10"
                                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"
                                                   HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                        <Setter TargetName="StatusBadge" Property="Background" Value="#DDF5E8"/>
                                        <Setter TargetName="StatusBadge" Property="TextElement.Foreground" Value="#14794A"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="86" Height="86" CornerRadius="26" Background="#CFE8EEF9">
                            <TextBlock Text="&#xE8CE;" FontFamily="Segoe Fluent Icons" FontSize="40"
                                       Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="选择一台设备查看详情" FontSize="18" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,18,0,6"/>
                        <TextBlock Text="实时网速、累计用量和上下线历史将在这里显示"
                                   Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer x:Name="DetailPanel" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,24,28,36">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="74"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="64" Height="64" CornerRadius="16" Background="{StaticResource AccentLightBrush}">
                                <TextBlock Text="{Binding SelectedDevice.IconGlyph}" FontFamily="Segoe Fluent Icons"
                                           FontSize="31" Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedDevice.DisplayName}" FontSize="26" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SelectedDevice.LastSeenText}" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="2" x:Name="DetailStatusBadge" CornerRadius="10" Padding="12,6"
                                    VerticalAlignment="Center" Background="#E4E7EC">
                                <TextBlock x:Name="DetailStatusText" Text="离线" FontWeight="SemiBold" Foreground="#6B7280"/>
                            </Border>
                        </Grid>

                        <Grid Margin="0,22,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="下载速度" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding SelectedDevice.DownloadSpeedText}" FontSize="24" FontWeight="SemiBold" Margin="0,7,0,0"/>
                                    <TextBlock Text="实时" Foreground="{StaticResource AccentBrush}" FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="6,0">
                                <StackPanel>
                                    <TextBlock Text="上传速度" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding SelectedDevice.UploadSpeedText}" FontSize="24" FontWeight="SemiBold" Margin="0,7,0,0"/>
                                    <TextBlock Text="实时" Foreground="{StaticResource AccentBrush}" FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="累计用量" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding SelectedDevice.TotalUsageText}" FontSize="24" FontWeight="SemiBold" Margin="0,7,0,0"/>
                                    <TextBlock Text="路由器统计" Foreground="{StaticResource AccentBrush}" FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="连接方式" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                                    <TextBlock Text="{Binding SelectedDevice.ConnectionText}" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="IP 地址" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                                    <TextBlock Text="{Binding SelectedDevice.IpAddress}" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="累计下载" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                                    <TextBlock Text="{Binding SelectedDevice.TotalDownloadText}" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="累计上传" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                                    <TextBlock Text="{Binding SelectedDevice.TotalUploadText}" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="设备设置" FontSize="18" FontWeight="SemiBold" Margin="0,25,0,11"/>
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="自定义名称" FontWeight="SemiBold"/>
                                    <TextBox x:Name="CustomNameBox" Margin="0,8,0,0"/>
                                    <TextBlock Text="留空时使用自动识别名称" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="设备类型与图标" FontWeight="SemiBold"/>
                                    <ComboBox x:Name="DeviceTypeCombo" Margin="0,8,0,0"
                                              DisplayMemberPath="DisplayText"/>
                                    <TextBlock Text="可随时调整实际类型和对应图标" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.ColumnSpan="2" Margin="0,86,0,0">
                                    <Separator Margin="0,3,0,13"/>
                                    <CheckBox x:Name="NotifyOnlineCheck" Content="设备上线时发送 Windows 系统通知" Margin="0,0,0,9"/>
                                    <CheckBox x:Name="NotifyOfflineCheck" Content="设备离线时发送 Windows 系统通知"/>
                                    <Button Content="保存设备设置" Style="{StaticResource PrimaryButtonStyle}"
                                            HorizontalAlignment="Right" Margin="0,14,0,0"
                                            Click="SaveDeviceButton_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="上下线历史" FontSize="18" FontWeight="SemiBold" Margin="0,25,0,11"/>
                        <Border Style="{StaticResource CardStyle}">
                            <ItemsControl ItemsSource="{Binding SelectedDevice.Sessions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#70F5F7FB"
                                                BorderBrush="#70DCE2EC"
                                                BorderThickness="1"
                                                CornerRadius="11"
                                                Padding="12,10"
                                                Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="12" Margin="0,4,0,4">
                                                <Border Width="2" Background="#A3B3C9"
                                                        HorizontalAlignment="Center"
                                                        Margin="0,6,0,6"/>
                                                <Ellipse Width="9" Height="9" Fill="{StaticResource AccentBrush}"
                                                         VerticalAlignment="Top"/>
                                                <Ellipse Width="9" Height="9" Fill="#97A4B7"
                                                         VerticalAlignment="Bottom"/>
                                            </Grid>
                                            <StackPanel Grid.Column="1">
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="62"/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="上线时间" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding OnlineAtText}" FontWeight="SemiBold"/>
                                                </Grid>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="62"/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="离线时间" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding OfflineAtText}" FontWeight="SemiBold"/>
                                                </Grid>
                                            </StackPanel>
                                            <Border Grid.Column="2" Background="#DCE8EDF5" CornerRadius="9"
                                                    Padding="9,5" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DurationText}" FontSize="10"/>
                                            </Border>
                                        </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="42,36" MaxWidth="620" HorizontalAlignment="Left">
                        <TextBlock Text="连接设置" FontSize="28" FontWeight="SemiBold"/>
                        <TextBlock Text="密码仅保存到当前 Windows 用户的凭据管理器，不会写入项目或日志。"
                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,7,0,22"/>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="路由器地址" FontWeight="SemiBold"/>
                                <TextBox x:Name="RouterAddressBox" Margin="0,8,0,16"/>
                                <TextBlock Text="管理员密码" FontWeight="SemiBold"/>
                                <PasswordBox x:Name="RouterPasswordBox" Margin="0,8,0,4"/>
                                <TextBlock Text="已保存密码时可留空；填写后会覆盖已有凭据。"
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="10"/>
                                <TextBlock Text="刷新间隔（秒）" FontWeight="SemiBold" Margin="0,16,0,0"/>
                                <ComboBox x:Name="RefreshIntervalCombo" Margin="0,8,0,0" Width="150" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="2"/>
                                    <ComboBoxItem Content="3"/>
                                    <ComboBoxItem Content="5"/>
                                    <ComboBoxItem Content="10"/>
                                </ComboBox>
                                <CheckBox x:Name="CloseToTrayCheck" Content="关闭窗口时继续在系统托盘监控"
                                          Margin="0,18,0,0"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                                    <Button Content="返回" Style="{StaticResource QuietButtonStyle}"
                                            Click="CancelSettingsButton_Click" Margin="0,0,9,0"/>
                                    <Button x:Name="ConnectButton" Content="保存并连接"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="ConnectButton_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border x:Name="SettingsMessageBorder" Visibility="Collapsed"
                                Background="#FFF4E5" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                            <TextBlock x:Name="SettingsMessageText" Foreground="#8A4B08" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="ConnectionDot" Width="7" Height="7" Fill="#9CA3AF"/>
                    <TextBlock x:Name="ConnectionStatusText" Text="尚未连接" FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}" Margin="7,0,0,0"/>
                </StackPanel>
                <TextBlock Text="数据仅保存在本机" FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
