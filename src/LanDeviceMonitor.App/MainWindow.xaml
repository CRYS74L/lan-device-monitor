                                       Text="正在读取上网信息…"
                                       Foreground="{StaticResource AccentBrush}"/>
                        </Border>

                        <Border x:Name="RouterIpInfoCard"
                                Style="{StaticResource CardStyle}"
                                Margin="0,12,0,0">
                            <Grid x:Name="RouterIpInfoGrid"
                                  SnapsToDevicePixels="True"
                                  UseLayoutRounding="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="Ipv4InfoCard"
                                    Background="{DynamicResource ListItemBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="20"
                                    Padding="13"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="IPv4 信息"
                                               FontSize="17"
                                               FontWeight="Normal"
                                               Margin="0,0,0,16"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0"
                                                   Text="连接类型："
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   HorizontalAlignment="Stretch"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Top"
                                                   Margin="0,0,18,11"/>
                                        <TextBlock x:Name="Ipv4TypeText"
                                                   Grid.Row="0"
                                                   Grid.Column="1"
                                                   Text="—"
                                                   FontWeight="Normal"
                                                   HorizontalAlignment="Left"
                                                   TextAlignment="Left"
                                                   VerticalAlignment="Top"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,0,11"/>
                                        <TextBlock Grid.Row="1"
                                                   Text="IP 地址："
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   HorizontalAlignment="Stretch"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Top"
                                                   Margin="0,0,18,11"/>
                                        <TextBlock x:Name="Ipv4AddressText"
                                                   Grid.Row="1"
                                                   Grid.Column="1"
                                                   Text="—"
                                                   FontWeight="Normal"
                                                   HorizontalAlignment="Left"
                                                   TextAlignment="Left"
                                                   VerticalAlignment="Top"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,0,11"/>
                                        <TextBlock Grid.Row="2"
                                                   Text="子网掩码："
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   HorizontalAlignment="Stretch"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Top"
                                                   Margin="0,0,18,11"/>
                                        <TextBlock x:Name="Ipv4MaskText"
                                                   Grid.Row="2"
                                                   Grid.Column="1"
                                                   Text="—"
                                                   FontWeight="Normal"
                                                   HorizontalAlignment="Left"
                                                   TextAlignment="Left"
                                                   VerticalAlignment="Top"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,0,11"/>
                                        <TextBlock Grid.Row="3"
                                                   Text="默认网关："
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   HorizontalAlignment="Stretch"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Top"
                                                   Margin="0,0,18,11"/>
                                        <TextBlock x:Name="Ipv4GatewayText"
                                                   Grid.Row="3"
                                                   Grid.Column="1"
                                                   Text="—"
                                                   FontWeight="Normal"
                                                   HorizontalAlignment="Left"
                                                   TextAlignment="Left"
                                                   VerticalAlignment="Top"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,0,11"/>
                                        <TextBlock Grid.Row="4"
                                                   Text="DNS："
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   HorizontalAlignment="Stretch"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Top"
                                                   Margin="0,0,18,0"/>
                                        <TextBlock x:Name="Ipv4DnsText"
                                                   Grid.Row="4"
                                                   Grid.Column="1"
                                                   Text="—"
                                                   FontWeight="Normal"
                                                   HorizontalAlignment="Left"
                                                   TextAlignment="Left"
                                                   VerticalAlignment="Top"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border x:Name="Ipv6InfoCard"
                                    Grid.Column="1"
                                    Background="{DynamicResource ListItemBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="20"
                                    Padding="13"
                                    HorizontalAlignment="Left"
                                    MinWidth="{Binding ActualWidth, ElementName=Ipv4InfoCard}"
                                    Margin="0">
                                <StackPanel>
                                    <TextBlock Text="IPv6 信息"
                                               FontSize="17"
                                               FontWeight="Normal"
                                               Margin="0,0,0,16"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0"
                                                   Text="连接类型："
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   HorizontalAlignment="Stretch"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Top"
                                                   Margin="0,0,18,11"/>
                                        <TextBlock x:Name="Ipv6TypeText"
                                                   Grid.Row="0"
                                                   Grid.Column="1"
                                                   Text="—"
                                                   FontWeight="Normal"
                                                   HorizontalAlignment="Left"
                                                   TextAlignment="Left"
                                                   VerticalAlignment="Top"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,0,11"/>
                                        <TextBlock Grid.Row="1"
                                                   Text="WAN IPv6 地址："
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   HorizontalAlignment="Stretch"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Top"
                                                   Margin="0,0,18,11"/>
                                        <TextBlock x:Name="WanIpv6AddressText"
                                                   Grid.Row="1"
                                                   Grid.Column="1"
                                                   Text="—"
                                                   FontWeight="Normal"
                                                   HorizontalAlignment="Left"
                                                   TextAlignment="Left"
                                                   VerticalAlignment="Top"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,0,11"/>
                                        <TextBlock Grid.Row="2"
                                                   Text="WAN IPv6 网关："
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   HorizontalAlignment="Stretch"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Top"
                                                   Margin="0,0,18,11"/>
                                        <TextBlock x:Name="WanIpv6GatewayText"
                                                   Grid.Row="2"
                                                   Grid.Column="1"
                                                   Text="—"
                                                   FontWeight="Normal"
                                                   HorizontalAlignment="Left"
                                                   TextAlignment="Left"
                                                   VerticalAlignment="Top"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,0,11"/>
                                        <TextBlock Grid.Row="3"
                                                   Text="LAN IPv6 地址："
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   HorizontalAlignment="Stretch"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Top"
                                                   Margin="0,0,18,11"/>
                                        <TextBlock x:Name="LanIpv6AddressText"
                                                   Grid.Row="3"
                                                   Grid.Column="1"
                                                   Text="—"
                                                   FontWeight="Normal"
                                                   HorizontalAlignment="Left"
                                                   TextAlignment="Left"
                                                   VerticalAlignment="Top"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,0,11"/>
                                        <TextBlock Grid.Row="4"
                                                   Text="LAN IPv6 前缀："
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   HorizontalAlignment="Stretch"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Top"
                                                   Margin="0,0,18,11"/>
                                        <TextBlock x:Name="LanIpv6PrefixText"
                                                   Grid.Row="4"
                                                   Grid.Column="1"
                                                   Text="—"
                                                   FontWeight="Normal"
                                                   HorizontalAlignment="Left"
                                                   TextAlignment="Left"
                                                   VerticalAlignment="Top"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,0,11"/>
                                        <TextBlock Grid.Row="5"
                                                   Text="DNS："
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   HorizontalAlignment="Stretch"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Top"
                                                   Margin="0,0,18,0"/>
                                        <TextBlock x:Name="Ipv6DnsText"
                                                   Grid.Row="5"
                                                   Grid.Column="1"
                                                   Text="—"
                                                   FontWeight="Normal"
                                                   HorizontalAlignment="Left"
                                                   TextAlignment="Left"
                                                   VerticalAlignment="Top"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            </Grid>
                        </Border>

                        <TextBlock Text="Mesh 网络节点"
                                   FontSize="18"
                                   FontWeight="Normal"
                                   Margin="0,24,0,11"/>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="每个数字表示当前直接连接到该节点的设备数量"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                                               FontSize="14"
                                           Margin="0,0,0,12"/>
                                <TextBlock x:Name="MeshNodesEmptyText"
                                           Text="当前路由器没有返回 Mesh 节点信息"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Visibility="Collapsed"/>
                                <ItemsControl x:Name="MeshNodesItemsControl">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="270"
                                                    MinHeight="104"
                                                    Background="{DynamicResource ListItemBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="20"
                                                    Padding="13"
                                                    Margin="0,0,10,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="46"/>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition Width="42"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="40" Height="40"
                                                            CornerRadius="18"
                                                            Background="{DynamicResource AccentLightBrush}"
                                                            VerticalAlignment="Top">
                                                        <TextBlock Text="&#xE8CE;"
                                                                   FontFamily="Segoe Fluent Icons"
                                                                   FontSize="18"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1"
                                                                Margin="0,0,8,0"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontWeight="Normal"
                                                                   FontSize="14"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding ConnectionText}"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                       FontSize="14"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,4,0,0"/>
                                                        <TextBlock Text="{Binding IpAddress}"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                       FontSize="14"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,2,0,0"/>
                                                        <TextBlock Text="{Binding Hardware}"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                       FontSize="14"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2"
                                                            Width="34"
                                                            Height="34"
                                                            CornerRadius="17"
                                                            Background="{DynamicResource AccentBrush}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ConnectedDeviceCount}"
                                                                   Foreground="White"
                                                                   FontWeight="Normal"
                                                                   FontSize="14"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="路由器操作" FontSize="18" FontWeight="Normal"
                                   Margin="0,24,0,11"/>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="18"
                                            Background="{DynamicResource DangerSurfaceBrush}">
                                        <TextBlock Text="&#xE777;" FontFamily="Segoe Fluent Icons"
                                                   FontSize="18" Foreground="{DynamicResource DangerTextBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="重启路由器" FontWeight="Normal"
                                                   Foreground="{DynamicResource DangerTextBrush}"/>
                                        <TextBlock Text="重启期间设备会暂时断网，应用会持续显示恢复进度"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="14" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="RestartRouterButton"
                                            Grid.Column="2"
                                            Background="{DynamicResource DangerSurfaceBrush}"
                                            Foreground="{DynamicResource DangerTextBrush}"
                                            MinHeight="34" Height="34"
                                            Padding="13,5"
                                            Click="RestartRouterButton_Click">
                                        <TextBlock Text="重启路由器"
                                                   Foreground="{DynamicResource DangerTextBrush}"
                                                   FontWeight="Normal"/>
                                    </Button>
                                </Grid>

                                <Border x:Name="RestartConfirmBorder"
                                        Visibility="Collapsed"
                                        Background="{DynamicResource ConfirmSurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Padding="12"
                                        Margin="0,14,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="确认现在重启？所有设备会暂时失去网络连接。"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="取消"
                                                    Style="{StaticResource QuietButtonStyle}"
                                                    MinHeight="30" Height="30" Padding="11,3"
                                                    Click="CancelRestartButton_Click"
                                                    Margin="0,0,7,0"/>
                                            <Button Style="{StaticResource DangerConfirmButtonStyle}"
                                                    MinHeight="30" Height="30" Padding="11,3"
                                                    Click="ConfirmRestartButton_Click">
                                                <TextBlock Text="确认重启"
                                                           Foreground="White"
                                                           FontWeight="Normal"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border x:Name="RouterRestartProgressBorder"
                                        Visibility="Collapsed"
                                        Background="{DynamicResource ProgressInfoBrush}"
                                        CornerRadius="16"
                                        Padding="12"
                                        Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="RouterRestartStatusText"
                                                   Text="正在准备重启…"
                                                   FontWeight="Normal"/>
                                        <ProgressBar x:Name="RouterRestartProgressBar"
                                                     IsIndeterminate="True"
                                                     Height="5"
                                                     Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="SettingsPanel"
                              Visibility="Collapsed"
                              Style="{StaticResource WindowsSettingsScrollViewerStyle}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="32,28,32,32" MaxWidth="720" HorizontalAlignment="Stretch">
                        <TextBlock Text="设置" FontSize="28" FontWeight="SemiBold"/>
                        <TextBlock Text="让设备助手按你的习惯工作。" Foreground="{DynamicResource MutedTextBrush}" Margin="0,7,0,0"/>
                        <TextBlock Text="通用" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" Margin="5,24,0,9"/>
                        <Border Style="{StaticResource CardStyle}" Padding="20,8">
                            <StackPanel>
                                <Grid Margin="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                                        <TextBlock Text="界面主题"/>
                                    </StackPanel>
                                    <ComboBox x:Name="ThemeModeCombo" Grid.Column="1" Width="150" VerticalAlignment="Center" SelectionChanged="AppBehaviorSetting_Changed">
                                        <ComboBoxItem Content="跟随系统" Tag="System"/>
                                        <ComboBoxItem Content="浅色模式" Tag="Light"/>
                                        <ComboBoxItem Content="深色模式" Tag="Dark"/>
                                    </ComboBox>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,5"/>
                                <Grid Margin="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                                        <TextBlock Text="开机启动"/>
                                        <TextBlock Text="登录 Windows 后自动运行" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <controls:SwitchControl x:Name="StartWithWindowsCheck" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="开机启动" Checked="AppBehaviorSetting_Changed" Unchecked="AppBehaviorSetting_Changed"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="路由器连接" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" Margin="5,24,0,9"/>
                        <Border Style="{StaticResource CardStyle}" Padding="20,8">
                            <StackPanel>
                                <Grid Margin="0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="路由器地址"/>
                                        <TextBox x:Name="RouterAddressBox" AutomationProperties.Name="路由器地址" Margin="0,8,0,0" TextChanged="RouterConnectionSetting_Changed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="管理员密码"/>
                                        <PasswordBox x:Name="RouterPasswordBox" AutomationProperties.Name="管理员密码" Margin="0,8,0,0" PasswordChanged="RouterConnectionSetting_Changed"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="密码留空可保留已保存的凭据。" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/>
                                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,5"/>
                                <Grid Margin="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                                        <TextBlock Text="刷新间隔"/>
                                        <TextBlock Text="单位：秒" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <ComboBox x:Name="RefreshIntervalCombo" Grid.Column="1" Width="100" VerticalAlignment="Center" SelectionChanged="AppBehaviorSetting_Changed">
                                        <ComboBoxItem Content="1"/>
                                        <ComboBoxItem Content="2"/>
                                        <ComboBoxItem Content="3"/>
                                        <ComboBoxItem Content="5"/>
                                        <ComboBoxItem Content="10"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="通知" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" Margin="5,24,0,9"/>
                        <Border Style="{StaticResource CardStyle}" Padding="20,8">
                            <StackPanel>
                                <Grid Margin="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                                        <TextBlock Text="定时免打扰"/>
                                        <TextBlock Text="在指定时段内暂停通知" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <controls:SwitchControl x:Name="DoNotDisturbCheck" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="定时免打扰" Checked="AppBehaviorSetting_Changed" Unchecked="AppBehaviorSetting_Changed"/>
                                </Grid>
                                <Grid Margin="0,4,0,14" IsEnabled="{Binding IsChecked, ElementName=DoNotDisturbCheck}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="免打扰时段" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/>
                                    <TextBox x:Name="DoNotDisturbStartBox" Grid.Column="1" Width="96" Height="40" Padding="12,0" VerticalContentAlignment="Center" MaxLength="5" TextAlignment="Center" AutomationProperties.Name="免打扰开始时间" TextChanged="AppBehaviorSetting_Changed"/>
                                    <TextBlock Grid.Column="2" Text="至" Margin="12,0" VerticalAlignment="Center"/>
                                    <TextBox x:Name="DoNotDisturbEndBox" Grid.Column="3" Width="96" Height="40" Padding="12,0" VerticalContentAlignment="Center" MaxLength="5" TextAlignment="Center" AutomationProperties.Name="免打扰结束时间" TextChanged="AppBehaviorSetting_Changed"/>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,5"/>
                                <Grid Margin="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                                        <TextBlock Text="IPv6 连接提醒"/>
                                        <TextBlock Text="连接类型不是 Native 时发送 Windows 通知" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <controls:SwitchControl x:Name="NotifyIpv6NonNativeCheck" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="IPv6 连接提醒" Checked="AppBehaviorSetting_Changed" Unchecked="AppBehaviorSetting_Changed"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="局域网访问" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" Margin="5,24,0,9"/>
                        <Border Style="{StaticResource CardStyle}" Padding="20,8">
                            <StackPanel>
                                <Grid Margin="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
