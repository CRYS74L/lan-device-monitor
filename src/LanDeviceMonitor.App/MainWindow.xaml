                                        <TextBlock x:Name="DetailMacAddressText" MaxWidth="160" Margin="0,0,6,0" Text="{Binding SelectedDevice.MacAddress}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedDevice.MacAddress}"/>
                                        <Button x:Name="CopyDeviceMacButton" Grid.Column="1" Tag="MAC" Content="&#xE8C8;" FontFamily="Segoe Fluent Icons" Style="{StaticResource QuietButtonStyle}" MinWidth="28" Width="28" MinHeight="28" Height="28" Padding="0" ToolTip="复制 MAC 地址" AutomationProperties.Name="复制 MAC 地址" Click="CopyNetworkAddress_Click"/>
                                    </Grid>
                                </StackPanel>
