                                                        <RotateTransform Angle="180"/>
                                                    </Path.RenderTransform>
                                                </Path>
                                            </Viewbox>
                                            <StackPanel Grid.Column="1"
                                                        Margin="7,0,0,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="下载速度"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding SelectedDevice.DownloadSpeedValueText}"
                                                               FontSize="17"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding SelectedDevice.DownloadSpeedUnitText}"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               FontSize="10"
                                                               Margin="3,5,0,0"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="1"
                                            Background="{DynamicResource TimelineDurationBrush}"
                                            BorderBrush="{DynamicResource TimelineItemBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Margin="4,0"
                                            Padding="9,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Viewbox Width="20" Height="20"
                                                     VerticalAlignment="Center">
                                                <Path x:Name="UploadRateArrow"
                                                      Data="{StaticResource TrafficRateArrowGeometry}"
                                                      Fill="{DynamicResource TrafficUploadBrush}"/>
                                            </Viewbox>
                                            <StackPanel Grid.Column="1"
                                                        Margin="7,0,0,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="上传速度"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding SelectedDevice.UploadSpeedValueText}"
                                                               FontSize="17"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding SelectedDevice.UploadSpeedUnitText}"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               FontSize="10"
                                                               Margin="3,5,0,0"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="2"
                                            Background="{DynamicResource TimelineDurationBrush}"
                                            BorderBrush="{DynamicResource TimelineItemBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Margin="4,0"
                                            Padding="9,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Viewbox Width="20" Height="20"
                                                     VerticalAlignment="Center">
                                                <Path Data="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96M17 13l-4.65 4.65c-.2.2-.51.2-.71 0L7 13h3V9h4v4z"
                                                      Fill="{DynamicResource TrafficDownloadBrush}"/>
                                            </Viewbox>
                                            <StackPanel Grid.Column="1"
                                                        Margin="7,0,0,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="下载总量"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding SelectedDevice.TotalDownloadValueText}"
                                                               FontSize="17"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding SelectedDevice.TotalDownloadUnitText}"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               FontSize="10"
                                                               Margin="3,5,0,0"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="3"
                                            Background="{DynamicResource TimelineDurationBrush}"
                                            BorderBrush="{DynamicResource TimelineItemBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Margin="4,0,0,0"
                                            Padding="9,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Viewbox Width="20" Height="20"
                                                     VerticalAlignment="Center">
                                                <Path Data="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96M14 13v4h-4v-4H7l4.65-4.65c.2-.2.51-.2.71 0L17 13z"
                                                      Fill="{DynamicResource TrafficUploadBrush}"/>
                                            </Viewbox>
                                            <StackPanel Grid.Column="1"
                                                        Margin="7,0,0,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="上传总量"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding SelectedDevice.TotalUploadValueText}"
                                                               FontSize="17"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding SelectedDevice.TotalUploadUnitText}"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               FontSize="10"
                                                               Margin="3,5,0,0"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="连接方式" Foreground="{StaticResource MutedTextBrush}" FontSize="14"/>
                                    <TextBlock Text="{Binding SelectedDevice.ConnectionText}" FontWeight="Normal" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                    <TextBlock Text="IP 地址" Foreground="{StaticResource MutedTextBrush}" FontSize="14"/>
                                    <TextBlock Text="{Binding SelectedDevice.IpAddress}" FontWeight="Normal" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="MAC 地址" Foreground="{StaticResource MutedTextBrush}" FontSize="14"/>
                                    <TextBlock Text="{Binding SelectedDevice.MacAddress}" FontWeight="Normal" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="上下线历史" FontSize="18" FontWeight="Normal" Margin="0,25,0,11"/>
                        <Border Style="{StaticResource CardStyle}">
                            <ItemsControl x:Name="SessionHistoryItems"
                                          ItemsSource="{Binding DetailSessionItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource TimelineItemBrush}"
                                                BorderBrush="{DynamicResource TimelineItemBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="11"
                                                Padding="12,10"
                                                Margin="0,0,0,8"
                                                Visibility="{Binding ItemVisibility}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="12" Margin="0,4,0,4">
                                                <Border Width="2" Background="{DynamicResource TimelineLineBrush}"
                                                        HorizontalAlignment="Center"
                                                        Margin="0,6,0,6"/>
                                                <Ellipse Width="9" Height="9" Fill="{DynamicResource TimelineOfflineDotBrush}"
                                                         VerticalAlignment="Top"/>
                                                <Ellipse Width="9" Height="9" Fill="{DynamicResource TimelineOnlineDotBrush}"
                                                         VerticalAlignment="Bottom"/>
                                            </Grid>
                                            <Grid Grid.Column="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="62"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="离线时间" Foreground="{DynamicResource MutedTextBrush}" FontSize="14"/>
                                                <TextBlock Grid.Column="2" Text="{Binding OfflineDateText}" FontWeight="Normal"/>
                                                <TextBlock Grid.Column="4" Text="{Binding OfflineTimeText}" FontWeight="Normal"/>
                                                <TextBlock Grid.Row="1" Text="上线时间" Foreground="{DynamicResource MutedTextBrush}" FontSize="14" Margin="0,8,0,0"/>
                                                <TextBlock Grid.Column="2" Grid.Row="1" Text="{Binding OnlineDateText}" FontWeight="Normal" Margin="0,8,0,0"/>
                                                <TextBlock Grid.Column="4" Grid.Row="1" Text="{Binding OnlineTimeText}" FontWeight="Normal" Margin="0,8,0,0"/>
                                            </Grid>
                                            <Border Grid.Column="2"
                                                    Style="{StaticResource TimelineDurationBadgeStyle}">
                                            <TextBlock Text="{Binding DurationText}" FontSize="14"/>
                                            </Border>
                                        </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <TextBlock Text="设备设置" FontSize="18" FontWeight="Normal" Margin="0,25,0,11"/>
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="自定义名称" FontWeight="Normal"
                                           Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="设备类型与图标"
                                           FontWeight="Normal" Margin="10,0,0,0"/>

                                <TextBox x:Name="CustomNameBox"
                                         Grid.Row="1"
                                         Height="48"
                                         Margin="0,8,10,0"
                                         Padding="12,4"
                                         TextWrapping="NoWrap"
                                         AcceptsReturn="False"
                                         VerticalContentAlignment="Center"
                                         TextChanged="DeviceNameBox_TextChanged"/>
                                <ComboBox x:Name="DeviceTypeCombo"
                                          Grid.Row="1" Grid.Column="1"
                                          Height="48"
                                          Margin="10,8,0,0"
                                          SelectionChanged="DeviceProfileControl_Changed">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="26" Height="26" CornerRadius="7"
                                                        Background="{DynamicResource DeviceIconBrush}"
                                                        Margin="0,0,9,0">
                                                    <controls:DeviceTypeIcon DeviceType="{Binding TypeName}"
                                                                             Glyph="{Binding IconGlyph}"
                                                                             IconBrush="{DynamicResource AccentBrush}"
                                                                             Width="14" Height="14"
                                                                             HorizontalAlignment="Center"
                                                                             VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding TypeName}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Grid.Row="2"
                                           Text="留空时使用自动识别名称"
                                           Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="14" Margin="0,6,10,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="1"
                                           Text="可随时调整实际类型和对应图标"
                                           Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="14" Margin="10,6,0,0"/>

                                <Border Grid.Row="3" Grid.ColumnSpan="2"
                                        Height="1"
                                        Background="{StaticResource BorderBrush}"
                                        Margin="0,15,0,14"/>

                                <StackPanel Grid.Row="4" Grid.ColumnSpan="2">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox x:Name="NotifyStatusChangeCheck"
                                                      Checked="DeviceProfileControl_Changed"
                                                      Unchecked="DeviceProfileControl_Changed"/>
                                            <TextBlock Text="设备上下线时，推送 Windows 系统通知"
                                                       IsHitTestVisible="False"
                                                       VerticalAlignment="Center"
                                                       Margin="6,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock x:Name="AutoSaveStatusText"
                                                   Text=""
                                                   Visibility="Collapsed"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="14"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel x:Name="DeviceManagementSection"
                                    Visibility="Collapsed">
                            <TextBlock Text="设备管理"
                                       FontSize="18"
                                       FontWeight="Normal"
                                       Margin="0,25,0,11"/>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="40"
                                                Height="40"
                                                CornerRadius="11"
                                                Background="{DynamicResource DangerSurfaceBrush}">
                                            <TextBlock Text="&#xE74D;"
                                                       FontFamily="Segoe Fluent Icons"
                                                       FontSize="18"
                                                       Foreground="{DynamicResource DangerTextBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="移除该设备"
                                                       FontWeight="Normal"
                                                       Foreground="{DynamicResource DangerTextBrush}"/>
                                            <TextBlock Text="移除后会保留历史记录，设备再次上线时自动恢复显示"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="14"
                                                       Margin="0,4,12,0"/>
                                        </StackPanel>
                                        <Button x:Name="RemoveDeviceButton"
                                                Grid.Column="2"
                                                Background="{DynamicResource DangerSurfaceBrush}"
                                                Foreground="{DynamicResource DangerTextBrush}"
                                                MinHeight="34"
                                                Height="34"
                                                Padding="13,5"
                                                Click="RemoveDeviceButton_Click">
                                            <TextBlock Text="移除该设备"
                                                       Foreground="{DynamicResource DangerTextBrush}"
                                                       FontWeight="Normal"/>
                                        </Button>
                                    </Grid>
                                    <Border x:Name="RemoveDeviceConfirmBorder"
                                            Visibility="Collapsed"
                                            Background="{DynamicResource ConfirmSurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="12"
                                            Margin="0,14,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="确认移除？历史记录会保留，再次上线后会重新显示。"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,12,0"/>
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal">
                                                <Button Content="取消"
                                                        Style="{StaticResource QuietButtonStyle}"
                                                        MinHeight="30"
                                                        Height="30"
                                                        Padding="11,3"
                                                        Margin="0,0,7,0"
                                                        Click="CancelRemoveDeviceButton_Click"/>
                                                <Button Style="{StaticResource DangerConfirmButtonStyle}"
                                                        MinHeight="30"
                                                        Height="30"
                                                        Padding="11,3"
                                                        Click="ConfirmRemoveDeviceButton_Click">
                                                    <TextBlock Text="确认移除"
                                                               Foreground="White"
                                                               FontWeight="Normal"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="RouterPanel" Visibility="Collapsed"
                              Style="{StaticResource WindowsSettingsScrollViewerStyle}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="32,28,32,40">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="路由器与上网信息"
                                           FontSize="28" FontWeight="SemiBold"/>
                                <TextBlock Text="查看 IPv4、IPv6 连接信息并管理路由器"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Button x:Name="RefreshRouterInfoButton"
                                        Content="刷新"
                                        Style="{StaticResource QuietButtonStyle}"
                                        MinHeight="32" Height="32" Padding="12,4"
                                        Click="RefreshRouterInfoButton_Click"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,22,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="上网信息" FontSize="18" FontWeight="Normal"
                                       VerticalAlignment="Center"/>
                            <Border x:Name="RouterConnectionBadge"
                                    Grid.Column="1"
                                    Background="{DynamicResource StatusOnlineBrush}"
                                    CornerRadius="10"
                                    Padding="11,5">
                                <TextBlock x:Name="RouterConnectionBadgeText"
                                           Text="正在读取"
                                           Foreground="{DynamicResource StatusOnlineTextBrush}"
                                           FontWeight="Normal"
                                                   FontSize="14"/>
                            </Border>
                        </Grid>

                        <Border x:Name="RouterInfoLoadingBorder"
                                Background="{DynamicResource AccentLightBrush}"
                                BorderBrush="#8FA8BEFF"
                                BorderThickness="1"
                                CornerRadius="11"
                                Padding="12,9"
                                Margin="0,12,0,0">
                            <TextBlock x:Name="RouterInfoLoadingText"
                                       Text="正在读取上网信息…"
                                       Foreground="{StaticResource AccentBrush}"/>
                        </Border>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource CardStyle}"
                                    Margin="0,0,7,0">
                                <StackPanel>
                                    <TextBlock Text="IPv4 信息"
                                               FontSize="17"
                                               FontWeight="Normal"
                                               Margin="0,0,0,16"/>
                                    <Grid Margin="0,0,0,11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="84"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="连接类型" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock x:Name="Ipv4TypeText" Grid.Column="1" Text="—" FontWeight="Normal"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="84"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="IP 地址" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock x:Name="Ipv4AddressText" Grid.Column="1" Text="—" FontWeight="Normal"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="84"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="子网掩码" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock x:Name="Ipv4MaskText" Grid.Column="1" Text="—" FontWeight="Normal"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="84"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="默认网关" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock x:Name="Ipv4GatewayText" Grid.Column="1" Text="—" FontWeight="Normal"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="84"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="DNS" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock x:Name="Ipv4DnsText" Grid.Column="1" Text="—" FontWeight="Normal"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1"
                                    Style="{StaticResource CardStyle}"
                                    Margin="7,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="IPv6 信息"
                                               FontSize="17"
                                               FontWeight="Normal"
                                               Margin="0,0,0,16"/>
                                    <Grid Margin="0,0,0,11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="102"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="连接类型" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock x:Name="Ipv6TypeText" Grid.Column="1" Text="—" FontWeight="Normal"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="102"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="WAN IPv6 地址" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock x:Name="WanIpv6AddressText" Grid.Column="1" Text="—"
                                                   FontWeight="Normal" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="102"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="WAN IPv6 网关" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock x:Name="WanIpv6GatewayText" Grid.Column="1" Text="—"
                                                   FontWeight="Normal" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="102"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="LAN IPv6 地址" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock x:Name="LanIpv6AddressText" Grid.Column="1" Text="—"
                                                   FontWeight="Normal" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="102"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="LAN IPv6 前缀" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock x:Name="LanIpv6PrefixText" Grid.Column="1" Text="—"
                                                   FontWeight="Normal" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="102"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="DNS" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock x:Name="Ipv6DnsText" Grid.Column="1" Text="—"
                                                   FontWeight="Normal" TextWrapping="Wrap"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock Text="Mesh 网络节点"
                                   FontSize="18"
                                   FontWeight="Normal"
                                   Margin="0,24,0,11"/>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="每个数字表示当前直接连接到该节点的设备数量"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                                               FontSize="14"
                                           Margin="0,0,0,12"/>
                                <TextBlock x:Name="MeshNodesEmptyText"
                                           Text="当前路由器没有返回 Mesh 节点信息"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Visibility="Collapsed"/>
                                <ItemsControl x:Name="MeshNodesItemsControl">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="270"
                                                    MinHeight="104"
                                                    Background="{DynamicResource ListItemBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="13"
                                                    Padding="13"
                                                    Margin="0,0,10,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="46"/>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition Width="42"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="40" Height="40"
                                                            CornerRadius="11"
                                                            Background="{DynamicResource AccentLightBrush}"
                                                            VerticalAlignment="Top">
                                                        <TextBlock Text="&#xE8CE;"
                                                                   FontFamily="Segoe Fluent Icons"
                                                                   FontSize="18"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1"
                                                                Margin="0,0,8,0"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontWeight="Normal"
                                                                   FontSize="14"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding ConnectionText}"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                       FontSize="14"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,4,0,0"/>
                                                        <TextBlock Text="{Binding IpAddress}"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                       FontSize="14"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,2,0,0"/>
                                                        <TextBlock Text="{Binding Hardware}"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                       FontSize="14"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2"
                                                            Width="34"
                                                            Height="34"
                                                            CornerRadius="17"
                                                            Background="{DynamicResource AccentBrush}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ConnectedDeviceCount}"
                                                                   Foreground="White"
                                                                   FontWeight="Normal"
                                                                   FontSize="14"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="路由器操作" FontSize="18" FontWeight="Normal"
                                   Margin="0,24,0,11"/>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="11"
                                            Background="{DynamicResource DangerSurfaceBrush}">
                                        <TextBlock Text="&#xE777;" FontFamily="Segoe Fluent Icons"
                                                   FontSize="18" Foreground="{DynamicResource DangerTextBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="重启路由器" FontWeight="Normal"
                                                   Foreground="{DynamicResource DangerTextBrush}"/>
                                        <TextBlock Text="重启期间设备会暂时断网，应用会持续显示恢复进度"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="14" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="RestartRouterButton"
                                            Grid.Column="2"
                                            Background="{DynamicResource DangerSurfaceBrush}"
                                            Foreground="{DynamicResource DangerTextBrush}"
                                            MinHeight="34" Height="34"
                                            Padding="13,5"
                                            Click="RestartRouterButton_Click">
                                        <TextBlock Text="重启路由器"
                                                   Foreground="{DynamicResource DangerTextBrush}"
                                                   FontWeight="Normal"/>
                                    </Button>
                                </Grid>

                                <Border x:Name="RestartConfirmBorder"
                                        Visibility="Collapsed"
                                        Background="{DynamicResource ConfirmSurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12"
                                        Margin="0,14,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="确认现在重启？所有设备会暂时失去网络连接。"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="取消"
                                                    Style="{StaticResource QuietButtonStyle}"
                                                    MinHeight="30" Height="30" Padding="11,3"
                                                    Click="CancelRestartButton_Click"
                                                    Margin="0,0,7,0"/>
                                            <Button Style="{StaticResource DangerConfirmButtonStyle}"
                                                    MinHeight="30" Height="30" Padding="11,3"
                                                    Click="ConfirmRestartButton_Click">
                                                <TextBlock Text="确认重启"
                                                           Foreground="White"
                                                           FontWeight="Normal"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border x:Name="RouterRestartProgressBorder"
                                        Visibility="Collapsed"
                                        Background="{DynamicResource ProgressInfoBrush}"
                                        CornerRadius="10"
                                        Padding="12"
                                        Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="RouterRestartStatusText"
                                                   Text="正在准备重启…"
                                                   FontWeight="Normal"/>
                                        <ProgressBar x:Name="RouterRestartProgressBar"
                                                     IsIndeterminate="True"
                                                     Height="5"
                                                     Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="SettingsPanel"
                              Visibility="Collapsed"
                              Style="{StaticResource WindowsSettingsScrollViewerStyle}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="42,30,42,40"
                                MaxWidth="760"
                                HorizontalAlignment="Stretch">
                        <TextBlock Text="设置" FontSize="28" FontWeight="SemiBold"/>
                        <TextBlock Text="应用、通知与路由器连接偏好"
                                   Foreground="{DynamicResource MutedTextBrush}" Margin="0,7,0,22"/>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="路由器地址" FontWeight="Normal"/>
                                <TextBox x:Name="RouterAddressBox" Margin="0,8,0,16"
                                         TextChanged="RouterConnectionSetting_Changed"/>
                                <TextBlock Text="管理员密码" FontWeight="Normal"/>
                                <PasswordBox x:Name="RouterPasswordBox" Margin="0,8,0,4"
                                             PasswordChanged="RouterConnectionSetting_Changed"/>
                                <TextBlock Text="已保存密码时可留空；填写后会覆盖已有凭据。"
                                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="14"/>
                                <TextBlock Text="刷新间隔（秒）" FontWeight="Normal" Margin="0,16,0,0"/>
                                <ComboBox x:Name="RefreshIntervalCombo"
                                          Margin="0,8,0,0"
                                          Width="150"
                                          HorizontalAlignment="Left"
                                          SelectionChanged="AppBehaviorSetting_Changed">
                                    <ComboBoxItem Content="1"/>
                                    <ComboBoxItem Content="2"/>
                                    <ComboBoxItem Content="3"/>
                                    <ComboBoxItem Content="5"/>
                                    <ComboBoxItem Content="10"/>
                                </ComboBox>
                                <TextBlock Text="界面主题" FontWeight="Normal" Margin="0,16,0,0"/>
                                <ComboBox x:Name="ThemeModeCombo"
                                          Margin="0,8,0,0"
                                          Width="180"
                                          HorizontalAlignment="Left"
                                          SelectionChanged="AppBehaviorSetting_Changed">
                                    <ComboBoxItem Content="跟随系统" Tag="System"/>
                                    <ComboBoxItem Content="浅色模式" Tag="Light"/>
                                    <ComboBoxItem Content="深色模式" Tag="Dark"/>
                                </ComboBox>
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,18,0,0">
                                    <CheckBox x:Name="StartWithWindowsCheck"
                                              Checked="AppBehaviorSetting_Changed"
                                              Unchecked="AppBehaviorSetting_Changed"/>
                                    <TextBlock Text="登录 Windows 后自动启动此应用"
                                               IsHitTestVisible="False"
                                               VerticalAlignment="Center"
                                               Margin="6,0,0,0"/>
                                </StackPanel>

                                <Border Height="1"
                                        Background="{DynamicResource BorderBrush}"
                                        Margin="0,20,0,18"/>
                                <StackPanel Orientation="Horizontal"
                                            Margin="0">
                                    <CheckBox x:Name="DoNotDisturbCheck"
                                              Checked="AppBehaviorSetting_Changed"
                                              Unchecked="AppBehaviorSetting_Changed"/>
                                    <TextBlock Text="启用通知免打扰时段"
                                               IsHitTestVisible="False"
                                               VerticalAlignment="Center"
                                               Margin="6,0,0,0"/>
                                </StackPanel>
                                <Grid Margin="20,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="开始时间" VerticalAlignment="Center"
                                               Foreground="{DynamicResource MutedTextBrush}"/>
                                    <TextBox x:Name="DoNotDisturbStartBox"
                                             Grid.Column="1"
                                             Width="86"
                                             Height="40"
                                             Margin="10,0,18,0"
                                             Padding="6,3"
                                             MaxLength="5"
                                             TextAlignment="Center"
                                             HorizontalContentAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             TextChanged="AppBehaviorSetting_Changed"/>
                                    <TextBlock Grid.Column="2"
                                               Text="结束时间"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource MutedTextBrush}"/>
                                    <TextBox x:Name="DoNotDisturbEndBox"
                                             Grid.Column="3"
                                             Width="86"
                                             Height="40"
                                             Margin="10,0,0,0"
                                             Padding="6,3"
                                             MaxLength="5"
                                             TextAlignment="Center"
                                             HorizontalContentAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             TextChanged="AppBehaviorSetting_Changed"/>
                                </Grid>
                                <TextBlock Text="时间格式为 24 小时制，例如 22:30；跨越零点的时段会自动识别。"
                                           Margin="20,8,0,0"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="14"/>
                                 <StackPanel Orientation="Horizontal"
                                             Margin="0,16,0,0">
                                     <CheckBox x:Name="NotifyIpv6NonNativeCheck"
                                               Checked="AppBehaviorSetting_Changed"
                                               Unchecked="AppBehaviorSetting_Changed"/>
                                    <TextBlock Text="IPv6 连接类型不是 Native 时，推送 Windows 系统通知"
                                               IsHitTestVisible="False"
                                                VerticalAlignment="Center"
                                                Margin="6,0,0,0"/>
                                 </StackPanel>
                                 <Border Height="1"
                                         Background="{DynamicResource BorderBrush}"
                                         Margin="0,20,0,18"/>
                                 <Grid>
                                     <Grid.ColumnDefinitions>
                                         <ColumnDefinition Width="*"/>
                                         <ColumnDefinition Width="Auto"/>
                                     </Grid.ColumnDefinitions>
                                     <StackPanel>
                                         <TextBlock Text="Windows 系统通知" FontWeight="Normal"/>
                                         <TextBlock x:Name="NotificationStatusText"
                                                    Text="Windows 系统通知正在初始化。"
                                                    Foreground="{DynamicResource MutedTextBrush}"
                                                    TextWrapping="Wrap"
                                                    FontSize="14"
                                                    Margin="0,5,18,0"/>
                                     </StackPanel>
                                     <Button x:Name="TestWindowsNotificationButton"
                                             Grid.Column="1"
                                             Style="{StaticResource QuietButtonStyle}"
                                             MinHeight="34"
                                             Height="34"
                                             Padding="13,5"
                                             VerticalAlignment="Center"
                                             Click="TestWindowsNotificationButton_Click">
                                         <TextBlock Text="测试 Windows 通知"/>
                                     </Button>
                                 </Grid>
                                 <TextBlock x:Name="AppSettingsAutoSaveText"
                                            Text=""
                                            Visibility="Collapsed"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="14"
                                           HorizontalAlignment="Right"
                                           Margin="0,8,0,0"/>
                                <Border Height="1"
                                        Background="{DynamicResource BorderBrush}"
                                        Margin="0,20,0,16"/>
                                <Grid>
                                    <TextBlock Text="软件版本"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="AppVersionText"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource MutedTextBrush}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border x:Name="SettingsMessageBorder" Visibility="Collapsed"
                                Background="#FFF4E5" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                            <TextBlock x:Name="SettingsMessageText" Foreground="#8A4B08" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            </Border>
        </Grid>
        <Image x:Name="WindowTransitionSnapshot"
               Grid.RowSpan="3"
               Panel.ZIndex="2147483647"
               Stretch="Fill"
               Visibility="Collapsed"
               IsHitTestVisible="False"
               SnapsToDevicePixels="True"/>
    </Grid>
</Window>
