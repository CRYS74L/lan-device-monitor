<Window x:Class="LanDeviceMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:LanDeviceMonitor.Controls"
        mc:Ignorable="d"
        Title="局域网设备助手"
        Width="1180" Height="760"
        MinWidth="980" MinHeight="650"
        Icon="/局域网设备助手;component/Assets/SystemIcon.ico"
        WindowStartupLocation="CenterScreen"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="12"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Geometry x:Key="TrafficRateArrowGeometry">M12 19.5V4.5M4.7 11.8L12 4.5L19.3 11.8</Geometry>
        <GeometryGroup x:Key="TrafficTotalDownloadIconGeometry">
            <EllipseGeometry Center="14,14"
                             RadiusX="10.2"
                             RadiusY="10.2"/>
            <PathGeometry Figures="M14 8.6V19.4M8.8 14.2L14 19.4L19.2 14.2"/>
        </GeometryGroup>
        <GeometryGroup x:Key="TrafficTotalUploadIconGeometry">
            <EllipseGeometry Center="14,14"
                             RadiusX="10.2"
                             RadiusY="10.2"/>
            <PathGeometry Figures="M14 19.4V8.6M8.8 13.8L14 8.6L19.2 13.8"/>
        </GeometryGroup>
        <Style x:Key="MetricCardToolTipStyle" TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource SurfaceStrongBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TimelineItemBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="13"
                                   FontWeight="Normal"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   HorizontalAlignment="Center"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CaptionHoverBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"/>
                            <Border x:Name="CaptionHoverSurface"
                                    Background="{TemplateBinding BorderBrush}"
                                    Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CaptionHoverSurface"
                                        Property="Opacity"
                                        Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CaptionHoverSurface"
                                        Property="Opacity"
                                        Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseCaptionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"/>
                            <Border x:Name="CaptionHoverSurface"
                                    Background="{TemplateBinding BorderBrush}"
                                    Opacity="0"
                                    IsHitTestVisible="False"/>
                            <Grid HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <TextBlock x:Name="CloseGlyph"
                                           Text="&#xE8BB;"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="10"
                                           Foreground="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="CloseGlyphLight"
                                           Text="&#xE8BB;"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="10"
                                           Foreground="White"
                                           Opacity="0"
                                           IsHitTestVisible="False"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CaptionHoverSurface"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CloseGlyphLight"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CaptionHoverSurface"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CloseGlyphLight"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CaptionHoverSurface"
                                        Property="Opacity"
                                        Value="0.82"/>
                                <Setter TargetName="CloseGlyphLight"
                                        Property="Opacity"
                                        Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#FF525C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DeviceListBoxStyle" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer x:Name="PART_ScrollViewer"
                                      Style="{StaticResource WindowsSettingsScrollViewerStyle}"
                                      Focusable="False"
                                      CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,7"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid MinHeight="56">
                                        <Border x:Name="ItemBorder"
                                                Background="{DynamicResource DeviceListItemBrush}"
                                                BorderBrush="Transparent"
                                                BorderThickness="1"
                                                CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource CapsuleRadius}}"/>
                                        <Border x:Name="HoverBorder"
                                                Background="{DynamicResource DeviceListItemSelectedBrush}"
                                                BorderBrush="#8BA4BCFF"
                                                BorderThickness="1"
                                                CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource CapsuleRadius}}"
                                                Opacity="0"
                                                IsHitTestVisible="False"/>
                                        <Border x:Name="SelectedBorder"
                                                Background="{DynamicResource DeviceListItemSelectedBrush}"
                                                BorderBrush="#8BA4BCFF"
                                                BorderThickness="1"
                                                CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource CapsuleRadius}}"
                                                Opacity="0"
                                                IsHitTestVisible="False"/>
                                        <ContentPresenter Margin="10,10,18,10" UseLayoutRounding="False"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="SelectedBorder"
                                                    Property="Opacity"
                                                    Value="1"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                                <Condition Property="IsSelected" Value="False"/>
                                            </MultiTrigger.Conditions>
                                            <MultiTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="HoverBorder"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="1"
                                                                         Duration="0:0:0.24">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiTrigger.EnterActions>
                                            <MultiTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="HoverBorder"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="0"
                                                                         Duration="0:0:0.20">
                                                            <DoubleAnimation.EasingFunction>
                                                                <QuadraticEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiTrigger.ExitActions>
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="DeviceRowIconBackground" Width="36" Height="36" CornerRadius="18" HorizontalAlignment="Left"
                                    Background="{DynamicResource DeviceIconBrush}">
                                <controls:DeviceTypeIcon DeviceType="{Binding TypeName}"
                                                         Glyph="{Binding IconGlyph}"
                                                         IconBrush="{DynamicResource AccentBrush}"
                                                         Width="20" Height="20"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="Normal" FontSize="14"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"/>

                            </StackPanel>
                            <TextBlock x:Name="DeviceListRate" Grid.Column="2" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource TextBrush}"><Run Text="{Binding DownloadSpeedValueText, Mode=OneWay}" BaselineAlignment="Baseline"/><Run Text=" " FontSize="12"/><Run Text="{Binding DownloadSpeedUnitText, Mode=OneWay}" FontSize="12" BaselineAlignment="Baseline" Foreground="{DynamicResource MutedTextBrush}"/></TextBlock>
                            <TextBlock x:Name="OfflineRatePlaceholder" Grid.Column="2" Text="—" FontSize="14" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Visibility="Collapsed"/>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsOnline}" Value="True">

                                </DataTrigger>
                            <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                <Setter TargetName="DeviceListRate" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="OfflineRatePlaceholder" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Geometry x:Key="SidebarPanelGeometry">M4,2 L16,2 Q18,2 18,4 L18,14 Q18,16 16,16 L4,16 Q2,16 2,14 L2,4 Q2,2 4,2 M7,2 L7,16</Geometry>
        <Style x:Key="SidebarNavButtonStyle" TargetType="Button" BasedOn="{StaticResource FluentButtonBaseStyle}">
            <Setter Property="Height" Value="40"/><Setter Property="MinHeight" Value="36"/><Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="10,5"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="NavSurface" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="{DynamicResource QuietControlBrush}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="{DynamicResource AccentLightBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SidebarIconButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
            <Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid x:Name="WindowRoot"
          Background="Transparent"
          SnapsToDevicePixels="True"
          UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="Transparent">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Style="{StaticResource CaptionButtonStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="MinimizeWindowButton_Click"
                        ToolTip="最小化">
                    <TextBlock Text="&#xE921;"
                               FontFamily="Segoe Fluent Icons"
                               FontSize="10"/>
                </Button>
                <Button x:Name="MaximizeWindowButton"
                        Style="{StaticResource CaptionButtonStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="MaximizeWindowButton_Click"
                        ToolTip="最大化">
                    <TextBlock x:Name="MaximizeWindowGlyph"
                               Text="&#xE922;"
                               FontFamily="Segoe Fluent Icons"
                               FontSize="10"/>
                </Button>
                <Button Style="{StaticResource CloseCaptionButtonStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="CloseWindowButton_Click"
                        ToolTip="关闭"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="WorkspaceGrid" Grid.Row="1" SizeChanged="WorkspaceGrid_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition x:Name="SidebarColumn" Width="390" MinWidth="280" MaxWidth="520"/>
                <ColumnDefinition x:Name="SidebarDividerColumn" Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="NavigationRail" Grid.Column="0" Margin="8,10,0,10" Background="{DynamicResource MicaPanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="20">
                <Grid Margin="6,12"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <Button x:Name="SidebarRailDevicesButton" Style="{StaticResource SidebarIconButtonStyle}" Click="SidebarDevicesButton_Click" ToolTip="设备 · 局域网设备助手" AutomationProperties.Name="设备"><Image Source="Assets/AppIcon.png" Width="28" Height="28"/></Button>
                        <Button x:Name="SidebarToggleButton" Style="{StaticResource SidebarIconButtonStyle}" Margin="0,12,0,0" Click="SidebarToggleButton_Click" ToolTip="收起设备栏" AutomationProperties.Name="收起设备栏"><Path Data="{StaticResource SidebarPanelGeometry}" Width="18" Height="16" Stretch="Fill" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.4"/></Button>
                        <Button x:Name="SidebarRailRouterButton" Style="{StaticResource SidebarIconButtonStyle}" Margin="0,12,0,0" Click="RouterButton_Click" ToolTip="路由器" AutomationProperties.Name="路由器"><TextBlock Text="&#xE8CE;" FontFamily="Segoe Fluent Icons" FontSize="18"/></Button>
                        <Button x:Name="SidebarRailSettingsButton" Style="{StaticResource SidebarIconButtonStyle}" Margin="0,6,0,0" Click="SettingsButton_Click" ToolTip="设置" AutomationProperties.Name="设置"><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="18"/></Button>
                    </StackPanel>
                    <Grid Grid.Row="1" Height="36" Background="Transparent">
                        <Grid.ToolTip><ToolTip><StackPanel><TextBlock Text="局域网设备助手"/><TextBlock x:Name="ConnectionStatusText" Text="尚未连接" FontSize="12" Margin="0,5,0,0"/><TextBlock x:Name="LastRefreshText" Text="等待刷新" FontSize="12" Margin="0,3,0,0" Foreground="{DynamicResource MutedTextBrush}"/></StackPanel></ToolTip></Grid.ToolTip>
                        <Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="#9CA3AF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>
            <Border x:Name="DeviceSidebar" Grid.Column="1" Margin="6,10,2,10"
                    Background="{DynamicResource MicaPanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="28" ClipToBounds="True" SizeChanged="DeviceSidebar_SizeChanged">
                <Grid x:Name="SidebarExpandedContent" Margin="18" HorizontalAlignment="Left">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="设备" FontSize="24" FontWeight="SemiBold"/>
                        <controls:SegmentedControl x:Name="DeviceFilterSegments" Grid.Row="1" Margin="0,14,0,14" Height="40" FontSize="14" SelectedIndex="0" SelectionChanged="DeviceFilterSegments_SelectionChanged" AutomationProperties.Name="设备状态筛选">
                            <controls:SegmentItem AutomationProperties.Name="在线设备"><StackPanel Orientation="Horizontal"><TextBlock Text="在线"/><TextBlock x:Name="OnlineCountText" Text="0" Margin="7,0,0,0" FontWeight="Normal"/></StackPanel></controls:SegmentItem>
                            <controls:SegmentItem AutomationProperties.Name="离线设备"><StackPanel Orientation="Horizontal"><TextBlock Text="离线"/><TextBlock x:Name="OfflineCountText" Text="0" Margin="7,0,0,0" FontWeight="Normal"/></StackPanel></controls:SegmentItem>
                        </controls:SegmentedControl>
                        <Grid Grid.Row="2">
                            <ListBox x:Name="DeviceList" Style="{StaticResource DeviceListBoxStyle}" PreviewMouseLeftButtonDown="DeviceList_PreviewMouseLeftButtonDown" SelectionChanged="DeviceList_SelectionChanged"/>
                            <ListBox x:Name="DeviceListTransition" Style="{StaticResource DeviceListBoxStyle}" Visibility="Collapsed" IsHitTestVisible="False" Focusable="False"/>
                        </Grid>
                </Grid>
            </Border>

            <GridSplitter x:Name="SidebarSplitter" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" DragIncrement="1" KeyboardIncrement="10" DragCompleted="SidebarSplitter_DragCompleted" AutomationProperties.Name="调整设备栏宽度">
                <GridSplitter.Template><ControlTemplate TargetType="GridSplitter"><Grid Background="Transparent"><Border Width="2" Height="36" Background="{DynamicResource BorderBrush}" CornerRadius="1" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid></ControlTemplate></GridSplitter.Template>
            </GridSplitter>
            <Border x:Name="DetailSurface" Grid.Column="3"
                    Margin="6,10,10,10"
                    Background="{DynamicResource MicaPanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="28"
                    ClipToBounds="True">
            <Grid>
                <Grid x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="86" Height="86" CornerRadius="26"
                                Background="{DynamicResource AccentLightBrush}">
                            <TextBlock Text="&#xE8CE;" FontFamily="Segoe Fluent Icons" FontSize="40"
                                       Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="选择一台设备查看详情" FontSize="18" FontWeight="Normal"
                                   HorizontalAlignment="Center" Margin="0,18,0,6"/>
                        <TextBlock Text="实时网速、累计用量和上下线历史将在这里显示"
                                   Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer x:Name="DetailPanel" Visibility="Collapsed"
                              Style="{StaticResource WindowsSettingsScrollViewerStyle}"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,24,28,36">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="DetailIconColumn" Width="74"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="DetailDeviceIconBackground"
                                    Width="64" Height="64" CornerRadius="16"
                                    Background="{DynamicResource DeviceIconBrush}">
                                <controls:DeviceTypeIcon DeviceType="{Binding SelectedDevice.TypeName}"
                                                         Glyph="{Binding SelectedDevice.IconGlyph}"
                                                         IconBrush="{DynamicResource AccentBrush}"
                                                         Width="31" Height="31"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"/>
                            </Border>
                            <Grid x:Name="DetailNetworkSummaryPanel"
                                  Grid.Column="1"
                                  Margin="16,0,18,0"
                                  VerticalAlignment="Center">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Text="{Binding SelectedDevice.DisplayName}" FontSize="26" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                            <Border Grid.Column="2" x:Name="DetailStatusBadge" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource CapsuleRadius}}" Height="28" Padding="14,0"
                                    VerticalAlignment="Center" Background="#E4E7EC">
                                <TextBlock x:Name="DetailStatusText" Text="离线" FontSize="12" VerticalAlignment="Center" FontWeight="Normal" Foreground="#6B7280"/>
                            </Border>
                        </Grid>

                        <TextBlock Text="网络信息" FontSize="18" Margin="0,24,0,10"/>
                        <Border x:Name="DeviceNetworkInfoCard" Style="{StaticResource CardStyle}" Padding="18,16">
                            <Grid x:Name="DetailNetworkMetadataRow">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="0.7*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="连接类型" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="DetailConnectionText" Text="{Binding SelectedDevice.ConnectionText}" Height="28" Padding="0,4,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock x:Name="DetailIpLabelText" Text="IP 地址" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,8"/>
                                    <Grid HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="DetailIpAddressText" MaxWidth="120" Margin="0,0,6,0" Text="{Binding SelectedDevice.IpAddress}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedDevice.IpAddress}"/>
                                        <Button x:Name="CopyDeviceIpButton" Grid.Column="1" Tag="IP" Content="&#xE8C8;" FontFamily="Segoe Fluent Icons" Style="{StaticResource QuietButtonStyle}" MinWidth="28" Width="28" MinHeight="28" Height="28" Padding="0" ToolTip="复制 IP 地址" AutomationProperties.Name="复制 IP 地址" Click="CopyNetworkAddress_Click"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
