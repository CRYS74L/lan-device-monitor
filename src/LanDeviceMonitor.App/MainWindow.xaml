<Window x:Class="LanDeviceMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:LanDeviceMonitor.Controls"
        mc:Ignorable="d"
        Title="局域网设备助手"
        Width="1180" Height="760"
        MinWidth="980" MinHeight="650"
        Icon="Assets/SystemIcon.ico"
        WindowStartupLocation="CenterScreen"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="12"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CaptionSurface"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CaptionSurface"
                                        Property="Background"
                                        Value="{DynamicResource QuietControlBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CaptionSurface"
                                        Property="Opacity"
                                        Value="0.68"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseCaptionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource CaptionButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid x:Name="WindowRoot" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="Transparent">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Style="{StaticResource CaptionButtonStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="MinimizeWindowButton_Click"
                        ToolTip="最小化">
                    <TextBlock Text="&#xE921;"
                               FontFamily="Segoe Fluent Icons"
                               FontSize="10"/>
                </Button>
                <Button x:Name="MaximizeWindowButton"
                        Style="{StaticResource CaptionButtonStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="MaximizeWindowButton_Click"
                        ToolTip="最大化">
                    <TextBlock x:Name="MaximizeWindowGlyph"
                               Text="&#xE922;"
                               FontFamily="Segoe Fluent Icons"
                               FontSize="10"/>
                </Button>
                <Button Style="{StaticResource CloseCaptionButtonStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="CloseWindowButton_Click"
                        ToolTip="关闭">
                    <TextBlock Text="&#xE8BB;"
                               FontFamily="Segoe Fluent Icons"
                               FontSize="10"/>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Margin="10,6,10,0"
                Background="{DynamicResource MicaPanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="16">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="38" Height="38"
                           Source="Assets/AppIcon.png"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="Fant"
                           SnapsToDevicePixels="True"
                           UseLayoutRounding="True"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="局域网设备助手" FontSize="18" FontWeight="Normal"/>
                        <TextBlock Text="小米路由器设备状态与提醒"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="14"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,18,0">
                    <Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="#9CA3AF"/>
                    <TextBlock x:Name="ConnectionStatusText"
                               Text="尚未连接"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="7,0,0,0"/>
                    <Border Width="1" Height="20"
                            Background="{DynamicResource BorderBrush}"
                            Margin="13,0"/>
                    <TextBlock x:Name="LastRefreshText"
                               Text="等待刷新"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource QuietButtonStyle}"
                            Height="32" MinHeight="32" MinWidth="86" Padding="12,4"
                            Margin="0,0,8,0"
                            Click="RouterButton_Click" ToolTip="查看上网信息与路由器操作">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8CE;" FontFamily="Segoe Fluent Icons"
                                       FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="路由器" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource QuietButtonStyle}"
                            Height="32" MinHeight="32" MinWidth="78" Padding="12,4"
                            Click="SettingsButton_Click" ToolTip="连接设置">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons"
                                       FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="设置" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="370"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="10,10,5,10"
                    Background="{DynamicResource MicaPanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="设备" FontSize="24" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    <Grid Grid.Row="1" Margin="0,16,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource OnlineCardBrush}" CornerRadius="9" Padding="14,10" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="在线设备" Foreground="{DynamicResource StatusOnlineTextBrush}" FontSize="14"/>
                                <TextBlock x:Name="OnlineCountText" Text="0" FontSize="24" FontWeight="Normal"
                                           Foreground="{DynamicResource StatusOnlineTextBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{DynamicResource OfflineCardBrush}" CornerRadius="9" Padding="14,10" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="离线设备" Foreground="{DynamicResource StatusOfflineTextBrush}" FontSize="14"/>
                                <TextBlock x:Name="OfflineCountText" Text="0" FontSize="24" FontWeight="Normal"
                                           Foreground="{DynamicResource StatusOfflineTextBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <ListBox x:Name="DeviceList" Grid.Row="2"
                             BorderThickness="0" Background="Transparent"
                             FocusVisualStyle="{x:Null}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseLeftButtonDown="DeviceList_PreviewMouseLeftButtonDown"
                             SelectionChanged="DeviceList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,7"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" Background="{DynamicResource ListItemBrush}"
                                                    BorderBrush="Transparent" BorderThickness="1"
                                                    CornerRadius="11" Padding="10,9">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#8BA4BCFF"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource DeviceListItemHoverBrush}"/>
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsSelected" Value="True"/>
                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="ItemBorder"
                                                            Property="Background"
                                                            Value="{DynamicResource DeviceListItemSelectedHoverBrush}"/>
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="42" Height="42" CornerRadius="10"
                                            Background="{DynamicResource DeviceIconBrush}">
                                        <controls:DeviceTypeIcon DeviceType="{Binding TypeName}"
                                                                 Glyph="{Binding IconGlyph}"
                                                                 IconBrush="{DynamicResource AccentBrush}"
                                                                 Width="21" Height="21"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Normal" FontSize="14"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding ConnectionText, Mode=OneWay}"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="14"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" MinWidth="58"
                                                VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <Border x:Name="StatusBadge" Width="48" Height="22"
                                                HorizontalAlignment="Right"
                                                Background="{DynamicResource StatusOfflineBrush}" CornerRadius="11">
                                            <TextBlock x:Name="StatusTextBlock"
                                                       Text="{Binding StatusText}" FontSize="13"
                                                       Foreground="{DynamicResource StatusOfflineTextBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding DownloadSpeedText}" FontSize="14"
                                                   Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0"
                                                   HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                        <Setter TargetName="StatusBadge" Property="Background" Value="{DynamicResource StatusOnlineBrush}"/>
                                        <Setter TargetName="StatusTextBlock" Property="Foreground" Value="{DynamicResource StatusOnlineTextBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Margin="5,10,10,10"
                    Background="{DynamicResource MicaPanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    ClipToBounds="True">
            <Grid>
                <Grid x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="86" Height="86" CornerRadius="26"
                                Background="{DynamicResource AccentLightBrush}">
                            <TextBlock Text="&#xE8CE;" FontFamily="Segoe Fluent Icons" FontSize="40"
                                       Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="选择一台设备查看详情" FontSize="18" FontWeight="Normal"
                                   HorizontalAlignment="Center" Margin="0,18,0,6"/>
                        <TextBlock Text="实时网速、累计用量和上下线历史将在这里显示"
                                   Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer x:Name="DetailPanel" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,24,28,36">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="74"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="64" Height="64" CornerRadius="16" Background="{StaticResource AccentLightBrush}">
                                <controls:DeviceTypeIcon DeviceType="{Binding SelectedDevice.TypeName}"
                                                         Glyph="{Binding SelectedDevice.IconGlyph}"
                                                         IconBrush="{DynamicResource AccentBrush}"
                                                         Width="31" Height="31"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedDevice.DisplayName}"
                                           FontSize="26"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding SelectedDevice.LastSeenText}" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="2" x:Name="DetailStatusBadge" CornerRadius="10" Padding="12,6"
                                    VerticalAlignment="Center" Background="#E4E7EC">
                                <TextBlock x:Name="DetailStatusText" Text="离线" FontWeight="Normal" Foreground="#6B7280"/>
                            </Border>
                        </Grid>

                        <Grid Margin="0,22,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="下载速度" Foreground="{StaticResource MutedTextBrush}" FontSize="14"/>
                                    <TextBlock Text="{Binding SelectedDevice.DownloadSpeedText}" FontSize="24" FontWeight="Normal" Margin="0,7,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="6,0">
                                <StackPanel>
                                    <TextBlock Text="上传速度" Foreground="{StaticResource MutedTextBrush}" FontSize="14"/>
                                    <TextBlock Text="{Binding SelectedDevice.UploadSpeedText}" FontSize="24" FontWeight="Normal" Margin="0,7,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="累计用量" Foreground="{StaticResource MutedTextBrush}" FontSize="14"/>
                                    <TextBlock Text="{Binding SelectedDevice.TotalUsageText}" FontSize="24" FontWeight="Normal" Margin="0,7,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                        <TextBlock Text="连接方式" Foreground="{StaticResource MutedTextBrush}" FontSize="14"/>
                                    <TextBlock Text="{Binding SelectedDevice.ConnectionText}" FontWeight="Normal" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                        <TextBlock Text="IP 地址" Foreground="{StaticResource MutedTextBrush}" FontSize="14"/>
                                    <TextBlock Text="{Binding SelectedDevice.IpAddress}" FontWeight="Normal" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                        <TextBlock Text="累计下载" Foreground="{StaticResource MutedTextBrush}" FontSize="14"/>
                                    <TextBlock Text="{Binding SelectedDevice.TotalDownloadText}" FontWeight="Normal" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                        <TextBlock Text="累计上传" Foreground="{StaticResource MutedTextBrush}" FontSize="14"/>
                                    <TextBlock Text="{Binding SelectedDevice.TotalUploadText}" FontWeight="Normal" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="设备设置" FontSize="18" FontWeight="Normal" Margin="0,25,0,11"/>
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="自定义名称" FontWeight="Normal"
                                           Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="设备类型与图标"
                                           FontWeight="Normal" Margin="10,0,0,0"/>

                                <TextBox x:Name="CustomNameBox"
                                         Grid.Row="1"
                                         MinHeight="48"
                                         Margin="0,8,10,0"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="False"
                                         VerticalContentAlignment="Center"
                                         TextChanged="DeviceNameBox_TextChanged"/>
                                <ComboBox x:Name="DeviceTypeCombo"
                                          Grid.Row="1" Grid.Column="1"
                                          Height="48"
                                          Margin="10,8,0,0"
                                          SelectionChanged="DeviceProfileControl_Changed">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="26" Height="26" CornerRadius="7"
                                                        Background="{StaticResource AccentLightBrush}"
                                                        Margin="0,0,9,0">
                                                    <controls:DeviceTypeIcon DeviceType="{Binding TypeName}"
                                                                             Glyph="{Binding IconGlyph}"
                                                                             IconBrush="{DynamicResource AccentBrush}"
                                                                             Width="14" Height="14"
                                                                             HorizontalAlignment="Center"
                                                                             VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding TypeName}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Grid.Row="2"
                                           Text="留空时使用自动识别名称"
                                           Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="14" Margin="0,6,10,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="1"
                                           Text="可随时调整实际类型和对应图标"
                                           Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="14" Margin="10,6,0,0"/>

                                <Border Grid.Row="3" Grid.ColumnSpan="2"
                                        Height="1"
                                        Background="{StaticResource BorderBrush}"
                                        Margin="0,15,0,14"/>

                                <StackPanel Grid.Row="4" Grid.ColumnSpan="2">
                                    <CheckBox x:Name="NotifyOnlineCheck"
                                              Content="设备上线时发送 Windows 系统通知"
                                              Margin="0,0,0,9"
                                              Checked="DeviceProfileControl_Changed"
                                              Unchecked="DeviceProfileControl_Changed"/>
                                    <Grid>
                                        <CheckBox x:Name="NotifyOfflineCheck"
                                                  Content="设备离线时发送 Windows 系统通知"
                                                  Checked="DeviceProfileControl_Changed"
                                                  Unchecked="DeviceProfileControl_Changed"/>
                                        <TextBlock x:Name="AutoSaveStatusText"
                                                   Text=""
                                                   Visibility="Collapsed"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="14"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="上下线历史" FontSize="18" FontWeight="Normal" Margin="0,25,0,11"/>
                        <Border Style="{StaticResource CardStyle}">
                            <ItemsControl ItemsSource="{Binding SelectedDevice.Sessions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#70F5F7FB"
                                                BorderBrush="#70DCE2EC"
                                                BorderThickness="1"
                                                CornerRadius="11"
                                                Padding="12,10"
                                                Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="12" Margin="0,4,0,4">
                                                <Border Width="2" Background="#A3B3C9"
                                                        HorizontalAlignment="Center"
                                                        Margin="0,6,0,6"/>
                                                <Ellipse Width="9" Height="9" Fill="{DynamicResource TimelineOfflineDotBrush}"
                                                         VerticalAlignment="Top"/>
                                                <Ellipse Width="9" Height="9" Fill="{DynamicResource TimelineOnlineDotBrush}"
                                                         VerticalAlignment="Bottom"/>
                                            </Grid>
                                            <StackPanel Grid.Column="1">
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="62"/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="离线时间" Foreground="{DynamicResource MutedTextBrush}" FontSize="14"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding OfflineAtText}" FontWeight="Normal"/>
                                                </Grid>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="62"/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="上线时间" Foreground="{DynamicResource MutedTextBrush}" FontSize="14"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding OnlineAtText}" FontWeight="Normal"/>
                                                </Grid>
                                            </StackPanel>
                                            <Border Grid.Column="2" Background="#DCE8EDF5" CornerRadius="9"
                                                    Padding="9,5" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DurationText}" FontSize="14"/>
                                            </Border>
                                        </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="RouterPanel" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="32,28,32,40">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="路由器与上网信息"
                                           FontSize="28" FontWeight="SemiBold"/>
                                <TextBlock Text="查看 IPv4、IPv6 连接信息并管理路由器"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Button x:Name="RefreshRouterInfoButton"
                                        Content="刷新"
                                        Style="{StaticResource QuietButtonStyle}"
                                        MinHeight="32" Height="32" Padding="12,4"
                                        Click="RefreshRouterInfoButton_Click"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,22,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="上网信息" FontSize="18" FontWeight="Normal"
                                       VerticalAlignment="Center"/>
                            <Border x:Name="RouterConnectionBadge"
                                    Grid.Column="1"
                                    Background="{DynamicResource StatusOnlineBrush}"
                                    CornerRadius="10"
                                    Padding="11,5">
                                <TextBlock x:Name="RouterConnectionBadgeText"
                                           Text="正在读取"
                                           Foreground="{DynamicResource StatusOnlineTextBrush}"
                                           FontWeight="Normal"
                                                   FontSize="14"/>
                            </Border>
                        </Grid>

                        <Border x:Name="RouterInfoLoadingBorder"
                                Background="{DynamicResource AccentLightBrush}"
                                BorderBrush="#8FA8BEFF"
                                BorderThickness="1"
                                CornerRadius="11"
                                Padding="12,9"
                                Margin="0,12,0,0">
                            <TextBlock x:Name="RouterInfoLoadingText"
                                       Text="正在读取上网信息…"
                                       Foreground="{StaticResource AccentBrush}"/>
                        </Border>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource CardStyle}"
                                    Margin="0,0,7,0">
                                <StackPanel>
                                    <TextBlock Text="IPv4 信息"
                                               FontSize="17"
                                               FontWeight="Normal"
                                               Margin="0,0,0,16"/>
                                    <Grid Margin="0,0,0,11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="84"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="连接类型" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock x:Name="Ipv4TypeText" Grid.Column="1" Text="—" FontWeight="Normal"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="84"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="IP 地址" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock x:Name="Ipv4AddressText" Grid.Column="1" Text="—" FontWeight="Normal"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="84"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="子网掩码" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock x:Name="Ipv4MaskText" Grid.Column="1" Text="—" FontWeight="Normal"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="84"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="默认网关" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock x:Name="Ipv4GatewayText" Grid.Column="1" Text="—" FontWeight="Normal"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="84"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="DNS" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock x:Name="Ipv4DnsText" Grid.Column="1" Text="—" FontWeight="Normal"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1"
                                    Style="{StaticResource CardStyle}"
                                    Margin="7,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="IPv6 信息"
                                               FontSize="17"
                                               FontWeight="Normal"
                                               Margin="0,0,0,16"/>
                                    <Grid Margin="0,0,0,11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="102"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="连接类型" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock x:Name="Ipv6TypeText" Grid.Column="1" Text="—" FontWeight="Normal"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="102"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="WAN IPv6 地址" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock x:Name="WanIpv6AddressText" Grid.Column="1" Text="—"
                                                   FontWeight="Normal" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="102"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="WAN IPv6 网关" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock x:Name="WanIpv6GatewayText" Grid.Column="1" Text="—"
                                                   FontWeight="Normal" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="102"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="LAN IPv6 地址" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock x:Name="LanIpv6AddressText" Grid.Column="1" Text="—"
                                                   FontWeight="Normal" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="102"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="LAN IPv6 前缀" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock x:Name="LanIpv6PrefixText" Grid.Column="1" Text="—"
                                                   FontWeight="Normal" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="102"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="DNS" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock x:Name="Ipv6DnsText" Grid.Column="1" Text="—"
                                                   FontWeight="Normal" TextWrapping="Wrap"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock Text="Mesh 网络节点"
                                   FontSize="18"
                                   FontWeight="Normal"
                                   Margin="0,24,0,11"/>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="每个数字表示当前直接连接到该节点的设备数量"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                                               FontSize="14"
                                           Margin="0,0,0,12"/>
                                <TextBlock x:Name="MeshNodesEmptyText"
                                           Text="当前路由器没有返回 Mesh 节点信息"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Visibility="Collapsed"/>
                                <ItemsControl x:Name="MeshNodesItemsControl">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="270"
                                                    MinHeight="104"
                                                    Background="{DynamicResource ListItemBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="13"
                                                    Padding="13"
                                                    Margin="0,0,10,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="46"/>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition Width="42"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="40" Height="40"
                                                            CornerRadius="11"
                                                            Background="{DynamicResource AccentLightBrush}"
                                                            VerticalAlignment="Top">
                                                        <TextBlock Text="&#xE8CE;"
                                                                   FontFamily="Segoe Fluent Icons"
                                                                   FontSize="18"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1"
                                                                Margin="0,0,8,0"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontWeight="Normal"
                                                                   FontSize="14"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding ConnectionText}"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                       FontSize="14"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,4,0,0"/>
                                                        <TextBlock Text="{Binding IpAddress}"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                       FontSize="14"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,2,0,0"/>
                                                        <TextBlock Text="{Binding Hardware}"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                       FontSize="14"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2"
                                                            Width="34"
                                                            Height="34"
                                                            CornerRadius="17"
                                                            Background="{DynamicResource AccentBrush}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ConnectedDeviceCount}"
                                                                   Foreground="White"
                                                                   FontWeight="Normal"
                                                                   FontSize="14"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="路由器操作" FontSize="18" FontWeight="Normal"
                                   Margin="0,24,0,11"/>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="11"
                                            Background="{DynamicResource DangerSurfaceBrush}">
                                        <TextBlock Text="&#xE777;" FontFamily="Segoe Fluent Icons"
                                                   FontSize="18" Foreground="{DynamicResource DangerTextBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="重启路由器" FontWeight="Normal"
                                                   Foreground="{DynamicResource DangerTextBrush}"/>
                                        <TextBlock Text="重启期间设备会暂时断网，应用会持续显示恢复进度"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="14" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="RestartRouterButton"
                                            Grid.Column="2"
                                            Background="{DynamicResource DangerSurfaceBrush}"
                                            Foreground="{DynamicResource DangerTextBrush}"
                                            MinHeight="34" Height="34"
                                            Padding="13,5"
                                            Click="RestartRouterButton_Click">
                                        <TextBlock Text="重启路由器"
                                                   Foreground="{DynamicResource DangerTextBrush}"
                                                   FontWeight="Normal"/>
                                    </Button>
                                </Grid>

                                <Border x:Name="RestartConfirmBorder"
                                        Visibility="Collapsed"
                                        Background="#FFFFF4E5"
                                        BorderBrush="#F4C982"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12"
                                        Margin="0,14,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="确认现在重启？所有设备会暂时失去网络连接。"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="取消"
                                                    Style="{StaticResource QuietButtonStyle}"
                                                    MinHeight="30" Height="30" Padding="11,3"
                                                    Click="CancelRestartButton_Click"
                                                    Margin="0,0,7,0"/>
                                            <Button Content="确认重启"
                                                    Background="#C4362E" Foreground="White"
                                                    MinHeight="30" Height="30" Padding="11,3"
                                                    Click="ConfirmRestartButton_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border x:Name="RouterRestartProgressBorder"
                                        Visibility="Collapsed"
                                        Background="#DDEBF1FF"
                                        CornerRadius="10"
                                        Padding="12"
                                        Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="RouterRestartStatusText"
                                                   Text="正在准备重启…"
                                                   FontWeight="Normal"/>
                                        <ProgressBar x:Name="RouterRestartProgressBar"
                                                     IsIndeterminate="True"
                                                     Height="5"
                                                     Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="SettingsPanel"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="42,30,42,40"
                                MaxWidth="760"
                                HorizontalAlignment="Stretch">
                        <TextBlock Text="设置" FontSize="28" FontWeight="SemiBold"/>
                        <TextBlock Text="应用、通知与路由器连接偏好"
                                   Foreground="{DynamicResource MutedTextBrush}" Margin="0,7,0,22"/>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="路由器地址" FontWeight="Normal"/>
                                <TextBox x:Name="RouterAddressBox" Margin="0,8,0,16"
                                         TextChanged="RouterConnectionSetting_Changed"/>
                                <TextBlock Text="管理员密码" FontWeight="Normal"/>
                                <PasswordBox x:Name="RouterPasswordBox" Margin="0,8,0,4"
                                             PasswordChanged="RouterConnectionSetting_Changed"/>
                                <TextBlock Text="已保存密码时可留空；填写后会覆盖已有凭据。"
                                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="14"/>
                                <TextBlock Text="刷新间隔（秒）" FontWeight="Normal" Margin="0,16,0,0"/>
                                <ComboBox x:Name="RefreshIntervalCombo"
                                          Margin="0,8,0,0"
                                          Width="150"
                                          HorizontalAlignment="Left"
                                          SelectionChanged="AppBehaviorSetting_Changed">
                                    <ComboBoxItem Content="2"/>
                                    <ComboBoxItem Content="3"/>
                                    <ComboBoxItem Content="5"/>
                                    <ComboBoxItem Content="10"/>
                                </ComboBox>
                                <TextBlock Text="界面主题" FontWeight="Normal" Margin="0,16,0,0"/>
                                <ComboBox x:Name="ThemeModeCombo"
                                          Margin="0,8,0,0"
                                          Width="180"
                                          HorizontalAlignment="Left"
                                          SelectionChanged="AppBehaviorSetting_Changed">
                                    <ComboBoxItem Content="跟随系统" Tag="System"/>
                                    <ComboBoxItem Content="浅色模式" Tag="Light"/>
                                    <ComboBoxItem Content="深色模式" Tag="Dark"/>
                                </ComboBox>
                                <CheckBox x:Name="StartWithWindowsCheck"
                                          Content="登录 Windows 后自动启动此应用"
                                          Margin="0,18,0,0"
                                          Checked="AppBehaviorSetting_Changed"
                                          Unchecked="AppBehaviorSetting_Changed"/>

                                <Border Height="1"
                                        Background="{DynamicResource BorderBrush}"
                                        Margin="0,20,0,18"/>
                                <TextBlock Text="通知" FontSize="18" FontWeight="Normal"/>
                                <CheckBox x:Name="DoNotDisturbCheck"
                                          Content="启用通知免打扰时段"
                                          Margin="0,14,0,0"
                                          Checked="AppBehaviorSetting_Changed"
                                          Unchecked="AppBehaviorSetting_Changed"/>
                                <Grid Margin="20,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="130"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="开始时间" VerticalAlignment="Center"
                                               Foreground="{DynamicResource MutedTextBrush}"/>
                                    <TextBox x:Name="DoNotDisturbStartBox"
                                             Grid.Column="1"
                                             Margin="10,0,20,0"
                                             TextChanged="AppBehaviorSetting_Changed"/>
                                    <TextBlock Grid.Column="2"
                                               Text="结束时间"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource MutedTextBrush}"/>
                                    <TextBox x:Name="DoNotDisturbEndBox"
                                             Grid.Column="3"
                                             Margin="10,0,0,0"
                                             TextChanged="AppBehaviorSetting_Changed"/>
                                </Grid>
                                <TextBlock Text="时间格式为 24 小时制，例如 22:30；跨越零点的时段会自动识别。"
                                           Margin="20,8,0,0"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="14"/>
                                <CheckBox x:Name="NotifyIpv6NonNativeCheck"
                                          Content="IPv6 连接类型不是 Native 时发送 Windows 系统通知"
                                          Margin="0,16,0,0"
                                          Checked="AppBehaviorSetting_Changed"
                                          Unchecked="AppBehaviorSetting_Changed"/>
                                <TextBlock x:Name="AppSettingsAutoSaveText"
                                           Text=""
                                           Visibility="Collapsed"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                                               FontSize="14"
                                           HorizontalAlignment="Right"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="SettingsMessageBorder" Visibility="Collapsed"
                                Background="#FFF4E5" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                            <TextBlock x:Name="SettingsMessageText" Foreground="#8A4B08" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
