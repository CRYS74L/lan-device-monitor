                        </Border>

                        <Grid x:Name="TrafficSummaryHeader"
                              Margin="0,25,0,11">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TrafficSummaryTitleText"
                                       Text="流量统计"
                                       FontSize="18"
                                       FontWeight="Normal"
                                       VerticalAlignment="Center"
                                       TextWrapping="NoWrap"/>
                            <controls:SegmentedControl x:Name="TrafficRangeSegments" Grid.Column="1"
                                Width="228" Height="36" FontSize="13" SelectedIndex="2"
                                AutomationProperties.Name="流量统计时间区间"
                                SelectionChanged="TrafficRangeSegments_SelectionChanged">
                                <controls:SegmentItem><TextBlock Text="1 分钟" FontSize="13"/></controls:SegmentItem>
                                <controls:SegmentItem><TextBlock Text="5 分钟" FontSize="13"/></controls:SegmentItem>
                                <controls:SegmentItem><TextBlock Text="10 分钟" FontSize="13"/></controls:SegmentItem>
                            </controls:SegmentedControl>
                        </Grid>

                        <Border x:Name="TrafficSummaryCard"
                                Style="{StaticResource CardStyle}"
                                Padding="0">
                            <StackPanel>
                                <Border Margin="18,16,18,14"
                                        Height="178"
                                        Background="{DynamicResource TimelineDurationBrush}"
                                        BorderBrush="{DynamicResource TimelineItemBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        ClipToBounds="True">
                                    <controls:TrafficChart
                                        AutomationProperties.AutomationId="TrafficChart"
                                        AutomationProperties.Name="流量统计曲线"
                                        Samples="{Binding SelectedDevice.TrafficSamples}"
                                        DeviceKey="{Binding SelectedDevice.MacAddress}"
                                        RangeMinutes="{Binding TrafficRangeMinutes}"
                                        GridBrush="{DynamicResource TrafficChartGridBrush}"
                                        LabelBrush="{DynamicResource TrafficChartLabelBrush}"
                                        UploadBrush="{DynamicResource TrafficUploadBrush}"
                                        DownloadBrush="{DynamicResource AccentBrush}"
                                        SnapsToDevicePixels="True"/>
                                </Border>

                                <Grid Margin="18,0,18,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="DownloadRateCard"
                                            Grid.Column="0"
                                            Background="{DynamicResource TimelineDurationBrush}"
                                            BorderBrush="{DynamicResource TimelineItemBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="16"
                                            Margin="0,0,4,0"
                                            Padding="9,8">
                                        <StackPanel x:Name="DownloadRateMetricContent"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <StackPanel.RenderTransform>
                                                <TranslateTransform X="-11.5"/>
                                            </StackPanel.RenderTransform>
                                            <Path x:Name="DownloadRateArrow"
                                                  Width="24"
                                                  Height="24"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,7,0"
                                                  Stretch="None"
                                                  Data="{StaticResource TrafficRateArrowGeometry}"
                                                  Stroke="{DynamicResource AccentBrush}"
                                                  StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Fill="Transparent"
                                                  RenderTransformOrigin="0.5,0.5">
                                                <Path.RenderTransform>
                                                    <RotateTransform Angle="180"/>
                                                </Path.RenderTransform>
                                            </Path>
                                            <Grid VerticalAlignment="Center">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="下载速度"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="12"
                                                           HorizontalAlignment="Center"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Canvas Grid.Row="1"
                                                        Height="24"
                                                        Margin="0,2,0,0"
                                                        ClipToBounds="False">
                                                    <StackPanel Canvas.Left="0"
                                                                Orientation="Horizontal">
                                                        <TextBlock Text="{Binding SelectedDevice.DownloadSpeedValueText}"
                                                                   FontSize="17"
                                                                   TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock x:Name="DownloadSpeedUnitText"
                                                                   Text="{Binding SelectedDevice.DownloadSpeedUnitText}"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   FontSize="12"
                                                                   Margin="5,5,0,0"
                                                                   TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Canvas>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="UploadRateCard"
                                            Grid.Column="1"
                                            Background="{DynamicResource TimelineDurationBrush}"
                                            BorderBrush="{DynamicResource TimelineItemBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="16"
                                            Margin="4,0"
                                            Padding="9,8">
                                        <StackPanel x:Name="UploadRateMetricContent"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <StackPanel.RenderTransform>
                                                <TranslateTransform X="-11.5"/>
                                            </StackPanel.RenderTransform>
                                            <Path x:Name="UploadRateArrow"
                                                  Width="24"
                                                  Height="24"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,7,0"
                                                  Stretch="None"
                                                  Data="{StaticResource TrafficRateArrowGeometry}"
                                                  Stroke="{DynamicResource TrafficUploadBrush}"
                                                  StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Fill="Transparent"/>
                                            <Grid VerticalAlignment="Center">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="上传速度"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="12"
                                                           HorizontalAlignment="Center"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Canvas Grid.Row="1"
                                                        Height="24"
                                                        Margin="0,2,0,0"
                                                        ClipToBounds="False">
                                                    <StackPanel Canvas.Left="0"
                                                                Orientation="Horizontal">
                                                        <TextBlock Text="{Binding SelectedDevice.UploadSpeedValueText}"
                                                                   FontSize="17"
                                                                   TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock x:Name="UploadSpeedUnitText"
                                                                   Text="{Binding SelectedDevice.UploadSpeedUnitText}"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   FontSize="12"
                                                                   Margin="5,5,0,0"
                                                                   TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Canvas>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="DownloadTotalCard"
                                            Grid.Column="2"
                                            AutomationProperties.AutomationId="DownloadTotalCard"
                                            AutomationProperties.Name="下载总量统计"
                                            Background="{DynamicResource TimelineDurationBrush}"
                                            BorderBrush="{DynamicResource TimelineItemBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="16"
                                            Margin="4,0"
                                            Padding="9,8"
                                            ToolTipService.InitialShowDelay="250"
                                            ToolTipService.Placement="Bottom"
                                            ToolTipService.VerticalOffset="4">
                                        <ToolTipService.ToolTip>
                                            <ToolTip Style="{StaticResource MetricCardToolTipStyle}"
                                                     Placement="Bottom"
                                                     Width="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}"
                                                     Content="{Binding PlacementTarget.DataContext.SelectedDevice.TotalDownloadDateRangeText, RelativeSource={RelativeSource Self}}"/>
                                        </ToolTipService.ToolTip>
                                        <StackPanel x:Name="DownloadTotalMetricContent"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsHitTestVisible="False">
                                            <StackPanel.RenderTransform>
                                                <TranslateTransform X="-13.5"/>
                                            </StackPanel.RenderTransform>
                                            <Path x:Name="DownloadTotalIcon"
                                                  Width="28"
                                                  Height="28"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,7,0"
                                                  Stretch="None"
                                                  Data="{StaticResource TrafficTotalDownloadIconGeometry}"
                                                  Stroke="{DynamicResource AccentBrush}"
                                                  StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Fill="Transparent"/>
                                            <Grid VerticalAlignment="Center">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock x:Name="DownloadTotalTitleText"
                                                           Text="下载总量"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="12"
                                                           HorizontalAlignment="Center"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Canvas Grid.Row="1"
                                                        Height="24"
                                                        Margin="0,2,0,0"
                                                        ClipToBounds="False">
                                                    <StackPanel Canvas.Left="0"
                                                                Orientation="Horizontal">
                                                        <TextBlock Text="{Binding SelectedDevice.TotalDownloadValueText}"
                                                                   FontSize="17"
                                                                   TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock x:Name="DownloadTotalUnitText"
                                                                   Text="{Binding SelectedDevice.TotalDownloadUnitText}"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   FontSize="12"
                                                                   Margin="5,5,0,0"
                                                                   TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Canvas>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="UploadTotalCard"
                                            Grid.Column="3"
                                            AutomationProperties.AutomationId="UploadTotalCard"
                                            AutomationProperties.Name="上传总量统计"
                                            Background="{DynamicResource TimelineDurationBrush}"
                                            BorderBrush="{DynamicResource TimelineItemBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="16"
                                            Margin="4,0,0,0"
                                            Padding="9,8"
                                            ToolTipService.InitialShowDelay="250"
                                            ToolTipService.Placement="Bottom"
                                            ToolTipService.VerticalOffset="4">
                                        <ToolTipService.ToolTip>
                                            <ToolTip Style="{StaticResource MetricCardToolTipStyle}"
                                                     Placement="Bottom"
                                                     Width="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}"
                                                     Content="{Binding PlacementTarget.DataContext.SelectedDevice.TotalUploadDateRangeText, RelativeSource={RelativeSource Self}}"/>
                                        </ToolTipService.ToolTip>
                                        <StackPanel x:Name="UploadTotalMetricContent"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsHitTestVisible="False">
                                            <StackPanel.RenderTransform>
                                                <TranslateTransform X="-13.5"/>
                                            </StackPanel.RenderTransform>
                                            <Path x:Name="UploadTotalIcon"
                                                  Width="28"
                                                  Height="28"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,7,0"
                                                  Stretch="None"
                                                  Data="{StaticResource TrafficTotalUploadIconGeometry}"
                                                  Stroke="{DynamicResource TrafficUploadBrush}"
                                                  StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Fill="Transparent"/>
                                            <Grid VerticalAlignment="Center">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock x:Name="UploadTotalTitleText"
                                                           Text="上传总量"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="12"
                                                           HorizontalAlignment="Center"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Canvas Grid.Row="1"
                                                        Height="24"
                                                        Margin="0,2,0,0"
                                                        ClipToBounds="False">
                                                    <StackPanel Canvas.Left="0"
                                                                Orientation="Horizontal">
                                                        <TextBlock Text="{Binding SelectedDevice.TotalUploadValueText}"
                                                                   FontSize="17"
                                                                   TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock x:Name="UploadTotalUnitText"
                                                                   Text="{Binding SelectedDevice.TotalUploadUnitText}"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   FontSize="12"
                                                                   Margin="5,5,0,0"
                                                                   TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Canvas>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="SessionHistoryTitleText"
                                   Text="上下线历史"
                                   FontSize="18"
                                   FontWeight="Normal"
                                   Margin="0,25,0,11"/>
                        <Border Style="{StaticResource CardStyle}">
                            <ItemsControl x:Name="SessionHistoryItems"
                                          ItemsSource="{Binding DetailSessionItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource TimelineItemBrush}"
                                                BorderBrush="{DynamicResource TimelineItemBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="18"
                                                Padding="12,10"
                                                Margin="0,0,0,8"
                                                Visibility="{Binding ItemVisibility}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="12" Margin="0,4,0,4">
                                                <Border Width="2" Background="{DynamicResource TimelineLineBrush}"
                                                        HorizontalAlignment="Center"
                                                        Margin="0,6,0,6"/>
                                                <Ellipse Width="9" Height="9" Fill="{DynamicResource TimelineOfflineDotBrush}"
                                                         VerticalAlignment="Top"/>
                                                <Ellipse Width="9" Height="9" Fill="{DynamicResource TimelineOnlineDotBrush}"
                                                         VerticalAlignment="Bottom"/>
                                            </Grid>
                                            <Grid Grid.Column="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="62"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="离线时间" Foreground="{DynamicResource MutedTextBrush}" FontSize="14"/>
                                                <TextBlock Grid.Column="2" Text="{Binding OfflineDateText}" FontWeight="Normal"/>
                                                <TextBlock Grid.Column="4" Text="{Binding OfflineTimeText}" FontWeight="Normal"/>
                                                <TextBlock Grid.Row="1" Text="上线时间" Foreground="{DynamicResource MutedTextBrush}" FontSize="14" Margin="0,8,0,0"/>
                                                <TextBlock Grid.Column="2" Grid.Row="1" Text="{Binding OnlineDateText}" FontWeight="Normal" Margin="0,8,0,0"/>
                                                <TextBlock Grid.Column="4" Grid.Row="1" Text="{Binding OnlineTimeText}" FontWeight="Normal" Margin="0,8,0,0"/>
                                            </Grid>
                                            <Border Grid.Column="2"
                                                    Style="{StaticResource TimelineDurationBadgeStyle}">
                                            <TextBlock Text="{Binding DurationText}" FontSize="14" FontWeight="Normal" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                                            </Border>
                                        </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <TextBlock Text="设备设置" FontSize="18" FontWeight="Normal" Margin="0,25,0,11"/>
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="自定义名称" FontWeight="Normal"
                                           Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="设备类型与图标"
                                           FontWeight="Normal" Margin="10,0,0,0"/>

                                <TextBox x:Name="CustomNameBox"
                                         Grid.Row="1"
                                         Height="48"
                                         Margin="0,8,10,0"
                                         Padding="12,4"
                                         TextWrapping="NoWrap"
                                         AcceptsReturn="False"
                                         VerticalContentAlignment="Center"
                                         TextChanged="DeviceNameBox_TextChanged"/>
                                <ComboBox x:Name="DeviceTypeCombo"
                                          Grid.Row="1" Grid.Column="1"
                                          Height="48"
                                          Margin="10,8,0,0"
                                          SelectionChanged="DeviceProfileControl_Changed">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="26" Height="26" CornerRadius="13"
                                                        Background="{DynamicResource DeviceIconBrush}"
                                                        Margin="0,0,9,0">
                                                    <controls:DeviceTypeIcon DeviceType="{Binding TypeName}"
                                                                             Glyph="{Binding IconGlyph}"
                                                                             IconBrush="{DynamicResource AccentBrush}"
                                                                             Width="14" Height="14"
                                                                             HorizontalAlignment="Center"
                                                                             VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding TypeName}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Grid.Row="2"
                                           Text="留空时使用自动识别名称"
                                           Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="14" Margin="0,6,10,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="1"
                                           Text="可随时调整实际类型和对应图标"
                                           Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="14" Margin="10,6,0,0"/>

                                <Border Grid.Row="3" Grid.ColumnSpan="2"
                                        Height="1"
                                        Background="{StaticResource BorderBrush}"
                                        Margin="0,15,0,14"/>

                                <StackPanel Grid.Row="4" Grid.ColumnSpan="2">
                                    <Grid>
<Grid Margin="0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0" VerticalAlignment="Center"><TextBlock Text="设备上下线通知"/><TextBlock Text="设备状态变化时发送 Windows 通知" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0"/></StackPanel><controls:SwitchControl x:Name="NotifyStatusChangeCheck" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="设备上下线通知" Checked="DeviceProfileControl_Changed" Unchecked="DeviceProfileControl_Changed"/></Grid>
                                        <TextBlock x:Name="AutoSaveStatusText"
                                                   Text=""
                                                   Visibility="Collapsed"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="14"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel x:Name="DeviceManagementSection"
                                    Visibility="Collapsed">
                            <TextBlock Text="设备管理"
                                       FontSize="18"
                                       FontWeight="Normal"
                                       Margin="0,25,0,11"/>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="40"
                                                Height="40"
                                                CornerRadius="18"
                                                Background="{DynamicResource DangerSurfaceBrush}">
                                            <TextBlock Text="&#xE74D;"
                                                       FontFamily="Segoe Fluent Icons"
                                                       FontSize="18"
                                                       Foreground="{DynamicResource DangerTextBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="移除该设备"
                                                       FontWeight="Normal"
                                                       Foreground="{DynamicResource DangerTextBrush}"/>
                                            <TextBlock Text="移除后会保留历史记录，设备再次上线时自动恢复显示"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="14"
                                                       Margin="0,4,12,0"/>
                                        </StackPanel>
                                        <Button x:Name="RemoveDeviceButton"
                                                Grid.Column="2"
                                                Background="{DynamicResource DangerSurfaceBrush}"
                                                Foreground="{DynamicResource DangerTextBrush}"
                                                MinHeight="34"
                                                Height="34"
                                                Padding="13,5"
                                                Click="RemoveDeviceButton_Click">
                                            <TextBlock Text="移除该设备"
                                                       Foreground="{DynamicResource DangerTextBrush}"
                                                       FontWeight="Normal"/>
                                        </Button>
                                    </Grid>
                                    <Border x:Name="RemoveDeviceConfirmBorder"
                                            Visibility="Collapsed"
                                            Background="{DynamicResource ConfirmSurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="16"
                                            Padding="12"
                                            Margin="0,14,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="确认移除？历史记录会保留，再次上线后会重新显示。"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,12,0"/>
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal">
                                                <Button Content="取消"
                                                        Style="{StaticResource QuietButtonStyle}"
                                                        MinHeight="30"
                                                        Height="30"
                                                        Padding="11,3"
                                                        Margin="0,0,7,0"
                                                        Click="CancelRemoveDeviceButton_Click"/>
                                                <Button Style="{StaticResource DangerConfirmButtonStyle}"
                                                        MinHeight="30"
                                                        Height="30"
                                                        Padding="11,3"
                                                        Click="ConfirmRemoveDeviceButton_Click">
                                                    <TextBlock Text="确认移除"
                                                               Foreground="White"
                                                               FontWeight="Normal"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="RouterPanel" Visibility="Collapsed"
                              Style="{StaticResource WindowsSettingsScrollViewerStyle}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="32,28,32,40">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="路由器与上网信息"
                                           FontSize="28" FontWeight="SemiBold"/>
                                <TextBlock Text="查看 IPv4、IPv6 连接信息并管理路由器"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Button x:Name="RefreshRouterInfoButton"
                                        Content="刷新"
                                        Style="{StaticResource QuietButtonStyle}"
                                        MinHeight="32" Height="32" Padding="12,4"
                                        Click="RefreshRouterInfoButton_Click"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,22,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="上网信息" FontSize="18" FontWeight="Normal"
                                       VerticalAlignment="Center"/>
                            <Border x:Name="RouterConnectionBadge"
                                    Grid.Column="1"
                                    Background="{DynamicResource StatusOnlineBrush}"
                                    CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource CapsuleRadius}}"
                                    Height="28" Padding="14,0">
                                <TextBlock x:Name="RouterConnectionBadgeText"
                                           Text="正在读取"
                                           Foreground="{DynamicResource StatusOnlineTextBrush}"
                                           FontWeight="Normal"
                                                   FontSize="12" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <Border x:Name="RouterInfoLoadingBorder"
                                Background="{DynamicResource AccentLightBrush}"
                                BorderBrush="#8FA8BEFF"
                                BorderThickness="1"
                                CornerRadius="18"
                                Padding="12,9"
                                Margin="0,12,0,0">
