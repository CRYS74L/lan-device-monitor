<Window x:Class="LanDeviceMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:LanDeviceMonitor.Controls"
        mc:Ignorable="d"
        Title="局域网设备助手"
        Width="1180" Height="760"
        MinWidth="980" MinHeight="650"
        Icon="/局域网设备助手;component/Assets/SystemIcon.ico"
        WindowStartupLocation="CenterScreen"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="12"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Geometry x:Key="TrafficRateArrowGeometry">M13 19V7.83l4.88 4.88c.39.39 1.03.39 1.42 0s.39-1.02 0-1.41l-6.59-6.59a.996.996 0 0 0-1.41 0l-6.6 6.58c-.39.39-.39 1.02 0 1.41s1.02.39 1.41 0L11 7.83V19c0 .55.45 1 1 1s1-.45 1-1</Geometry>
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CaptionHoverBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"/>
                            <Border x:Name="CaptionHoverSurface"
                                    Background="{TemplateBinding BorderBrush}"
                                    Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CaptionHoverSurface"
                                        Property="Opacity"
                                        Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CaptionHoverSurface"
                                        Property="Opacity"
                                        Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseCaptionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"/>
                            <Border x:Name="CaptionHoverSurface"
                                    Background="{TemplateBinding BorderBrush}"
                                    Opacity="0"
                                    IsHitTestVisible="False"/>
                            <Grid HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <TextBlock x:Name="CloseGlyph"
                                           Text="&#xE8BB;"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="10"
                                           Foreground="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="CloseGlyphLight"
                                           Text="&#xE8BB;"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="10"
                                           Foreground="White"
                                           Opacity="0"
                                           IsHitTestVisible="False"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CaptionHoverSurface"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CloseGlyphLight"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CaptionHoverSurface"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CloseGlyphLight"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CaptionHoverSurface"
                                        Property="Opacity"
                                        Value="0.82"/>
                                <Setter TargetName="CloseGlyphLight"
                                        Property="Opacity"
                                        Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#FF525C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DeviceListBoxStyle" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer x:Name="PART_ScrollViewer"
                                      Style="{StaticResource WindowsSettingsScrollViewerStyle}"
                                      Focusable="False"
                                      CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,7"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid>
                                        <Border x:Name="ItemBorder"
                                                Background="{DynamicResource DeviceListItemBrush}"
                                                BorderBrush="Transparent"
                                                BorderThickness="1"
                                                CornerRadius="11"/>
                                        <Border x:Name="HoverBorder"
                                                Background="{DynamicResource DeviceListItemSelectedBrush}"
                                                BorderBrush="#8BA4BCFF"
                                                BorderThickness="1"
                                                CornerRadius="11"
                                                Opacity="0"
                                                IsHitTestVisible="False"/>
                                        <Border x:Name="SelectedBorder"
                                                Background="{DynamicResource DeviceListItemSelectedBrush}"
                                                BorderBrush="#8BA4BCFF"
                                                BorderThickness="1"
                                                CornerRadius="11"
                                                Opacity="0"
                                                IsHitTestVisible="False"/>
                                        <ContentPresenter Margin="10,9"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="SelectedBorder"
                                                    Property="Opacity"
                                                    Value="1"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                                <Condition Property="IsSelected" Value="False"/>
                                            </MultiTrigger.Conditions>
                                            <MultiTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="HoverBorder"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="1"
                                                                         Duration="0:0:0.24">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiTrigger.EnterActions>
                                            <MultiTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="HoverBorder"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="0"
                                                                         Duration="0:0:0.20">
                                                            <DoubleAnimation.EasingFunction>
                                                                <QuadraticEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiTrigger.ExitActions>
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="42" Height="42" CornerRadius="10"
                                    Background="{DynamicResource DeviceIconBrush}">
                                <controls:DeviceTypeIcon DeviceType="{Binding TypeName}"
                                                         Glyph="{Binding IconGlyph}"
                                                         IconBrush="{DynamicResource AccentBrush}"
                                                         Width="21" Height="21"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="Normal" FontSize="14"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding ConnectionText, Mode=OneWay}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="14"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" MinWidth="58"
                                        VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Border x:Name="StatusBadge" Width="48" Height="22"
                                        HorizontalAlignment="Right"
                                        Background="{DynamicResource StatusOfflineBrush}" CornerRadius="11">
                                    <TextBlock x:Name="StatusTextBlock"
                                               Text="{Binding StatusText}" FontSize="13"
                                               Foreground="{DynamicResource StatusOfflineTextBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding DownloadSpeedText}" FontSize="14"
                                           Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0"
                                           HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                <Setter TargetName="StatusBadge" Property="Background" Value="{DynamicResource StatusOnlineBrush}"/>
                                <Setter TargetName="StatusTextBlock" Property="Foreground" Value="{DynamicResource StatusOnlineTextBrush}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DeviceFilterCardButtonStyle"
               TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="FilterButtonRoot"
                              RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="HoverScale"
                                                    ScaleX="1"
                                                    ScaleY="1"/>
                                    <TranslateTransform x:Name="HoverFloat"
                                                        Y="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9"/>
                            <Border x:Name="PressedSurface"
                                    Background="#22000000"
                                    CornerRadius="9"
                                    Opacity="0"
                                    IsHitTestVisible="False"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.03"
                                                             Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="HoverScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.03"
                                                             Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="HoverFloat"
                                                             Storyboard.TargetProperty="Y"
                                                             To="-3"
                                                             Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1"
                                                             Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="HoverScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1"
                                                             Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="HoverFloat"
                                                             Storyboard.TargetProperty="Y"
                                                             To="0"
                                                             Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressedSurface"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressedSurface"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="WindowRoot" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="Transparent">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Style="{StaticResource CaptionButtonStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="MinimizeWindowButton_Click"
                        ToolTip="最小化">
                    <TextBlock Text="&#xE921;"
                               FontFamily="Segoe Fluent Icons"
                               FontSize="10"/>
                </Button>
                <Button x:Name="MaximizeWindowButton"
                        Style="{StaticResource CaptionButtonStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="MaximizeWindowButton_Click"
                        ToolTip="最大化">
                    <TextBlock x:Name="MaximizeWindowGlyph"
                               Text="&#xE922;"
                               FontFamily="Segoe Fluent Icons"
                               FontSize="10"/>
                </Button>
                <Button Style="{StaticResource CloseCaptionButtonStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="CloseWindowButton_Click"
                        ToolTip="关闭"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Margin="10,6,10,0"
                Background="{DynamicResource MicaPanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="16">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="38" Height="38"
                           Source="Assets/AppIcon.png"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="Fant"
                           SnapsToDevicePixels="True"
                           UseLayoutRounding="True"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="局域网设备助手" FontSize="18" FontWeight="Normal"/>
                        <TextBlock Text="小米路由器设备状态与提醒"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="14"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,18,0">
                    <Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="#9CA3AF"/>
                    <TextBlock x:Name="ConnectionStatusText"
                               Text="尚未连接"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="7,0,0,0"/>
                    <Border Width="1" Height="20"
                            Background="{DynamicResource BorderBrush}"
                            Margin="13,0"/>
                    <TextBlock x:Name="LastRefreshText"
                               Text="等待刷新"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource QuietButtonStyle}"
                            Height="32" MinHeight="32" MinWidth="86" Padding="12,4"
                            Margin="0,0,8,0"
                            Click="RouterButton_Click" ToolTip="查看上网信息与路由器操作">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8CE;" FontFamily="Segoe Fluent Icons"
                                       FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="路由器" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource QuietButtonStyle}"
                            Height="32" MinHeight="32" MinWidth="78" Padding="12,4"
                            Click="SettingsButton_Click" ToolTip="连接设置">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons"
                                       FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="设置" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="370"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="10,10,5,10"
                    Background="{DynamicResource MicaPanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    ClipToBounds="True">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="设备" FontSize="24" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    <Grid Grid.Row="1" Margin="0,16,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="OnlineDevicesFilterButton"
                                Style="{StaticResource DeviceFilterCardButtonStyle}"
                                Background="{DynamicResource OnlineCardBrush}"
                                BorderBrush="{DynamicResource OnlineCardBorderBrush}"
                                BorderThickness="1"
                                Padding="14,10" Margin="0,0,6,0"
                                Click="OnlineDevicesFilterButton_Click">
                            <StackPanel>
                                <TextBlock Text="在线设备" Foreground="{DynamicResource StatusOnlineTextBrush}" FontSize="14"/>
                                <TextBlock x:Name="OnlineCountText" Text="0" FontSize="24" FontWeight="Normal"
                                           Foreground="{DynamicResource StatusOnlineTextBrush}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="OfflineDevicesFilterButton"
                                Grid.Column="1"
                                Style="{StaticResource DeviceFilterCardButtonStyle}"
                                Background="{DynamicResource OfflineCardBrush}"
                                BorderBrush="{DynamicResource OfflineCardBorderBrush}"
                                BorderThickness="1"
                                Padding="14,10" Margin="6,0,0,0"
                                Click="OfflineDevicesFilterButton_Click">
                            <StackPanel>
                                <TextBlock Text="离线设备" Foreground="{DynamicResource StatusOfflineTextBrush}" FontSize="14"/>
                                <TextBlock x:Name="OfflineCountText" Text="0" FontSize="24" FontWeight="Normal"
                                           Foreground="{DynamicResource StatusOfflineTextBrush}"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="2">
                        <ListBox x:Name="DeviceList"
                                 Style="{StaticResource DeviceListBoxStyle}"
                                 PreviewMouseLeftButtonDown="DeviceList_PreviewMouseLeftButtonDown"
                                 SelectionChanged="DeviceList_SelectionChanged"/>
                        <ListBox x:Name="DeviceListTransition"
                                 Style="{StaticResource DeviceListBoxStyle}"
                                 Visibility="Collapsed"
                                 IsHitTestVisible="False"
                                 Focusable="False"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Margin="5,10,10,10"
                    Background="{DynamicResource MicaPanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    ClipToBounds="True">
            <Grid>
                <Grid x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="86" Height="86" CornerRadius="26"
                                Background="{DynamicResource AccentLightBrush}">
                            <TextBlock Text="&#xE8CE;" FontFamily="Segoe Fluent Icons" FontSize="40"
                                       Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="选择一台设备查看详情" FontSize="18" FontWeight="Normal"
                                   HorizontalAlignment="Center" Margin="0,18,0,6"/>
                        <TextBlock Text="实时网速、累计用量和上下线历史将在这里显示"
                                   Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer x:Name="DetailPanel" Visibility="Collapsed"
                              Style="{StaticResource WindowsSettingsScrollViewerStyle}"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,24,28,36">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="DetailIconColumn" Width="74"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="DetailDeviceIconBackground"
                                    Width="64" Height="64" CornerRadius="16"
                                    Background="{DynamicResource DeviceIconBrush}">
                                <controls:DeviceTypeIcon DeviceType="{Binding SelectedDevice.TypeName}"
                                                         Glyph="{Binding SelectedDevice.IconGlyph}"
                                                         IconBrush="{DynamicResource AccentBrush}"
                                                         Width="31" Height="31"
