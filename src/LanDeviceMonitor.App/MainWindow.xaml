                                            AutomationProperties.Name="流量统计时间区间"
                                            ToolTip="点击切换 1、5、10 分钟统计区间"
                                            Click="TrafficRangeButton_Click"/>
                                </Grid>

                                <Border Margin="18,0,18,14"
