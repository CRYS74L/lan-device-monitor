<Window x:Class="LanDeviceMonitor.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="局域网设备助手"
        Width="202"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        Deactivated="Window_Deactivated"
        Loaded="Window_Loaded">
    <Border Margin="9"
            Padding="5"
            Background="#F7F9FC"
            BorderBrush="#D6DDE8"
            BorderThickness="1"
            CornerRadius="11">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="5"
                              Direction="270" Opacity="0.24" Color="#16223C"/>
        </Border.Effect>
        <StackPanel>
            <Grid Margin="8,5,8,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="26" Height="26" CornerRadius="7"
                        Background="{StaticResource AccentBrush}">
                    <TextBlock Text="&#xE8CE;" FontFamily="Segoe Fluent Icons"
                               FontSize="13" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="局域网设备助手" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock Text="设备状态正在后台监控" FontSize="8"
                               Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>
            </Grid>

            <Separator Margin="7,0" Background="#DDE3EC"/>

            <Button Click="OpenButton_Click"
                    Margin="0,4,0,1"
                    HorizontalContentAlignment="Stretch"
                    Background="Transparent"
                    MinHeight="32"
                    Padding="9,5"
                    FontSize="12"
                    FontWeight="Normal">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE8A7;" FontFamily="Segoe Fluent Icons"
                               FontSize="13" VerticalAlignment="Center"
                               Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Grid.Column="1" Text="打开主界面" VerticalAlignment="Center"/>
                </Grid>
            </Button>

            <Button Click="ExitButton_Click"
                    Margin="0,1,0,0"
                    HorizontalContentAlignment="Stretch"
                    Background="Transparent"
                    MinHeight="32"
                    Padding="9,5"
                    FontSize="12"
                    FontWeight="Normal">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons"
                               FontSize="13" VerticalAlignment="Center"
                               Foreground="#B42318"/>
                    <TextBlock Grid.Column="1" Text="退出应用" VerticalAlignment="Center"/>
                </Grid>
            </Button>
        </StackPanel>
    </Border>
</Window>
