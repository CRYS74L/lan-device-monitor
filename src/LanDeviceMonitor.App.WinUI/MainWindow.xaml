<Window
    x:Class="LanDeviceMonitor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:LanDeviceMonitor.ViewModels"
    mc:Ignorable="d"
    Title="局域网设备助手">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="Styles/ThemeResources.xaml"/>
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid x:Name="TitleBarRow" Background="Transparent">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="0">
                <Button x:Name="MinimizeButton"
                        Style="{StaticResource CaptionButtonStyle}"
                        Click="MinimizeButton_Click">
                    <FontIcon Glyph="&#xE921;" FontSize="10"/>
                </Button>
                <Button x:Name="MaximizeButton"
                        Style="{StaticResource CaptionButtonStyle}"
                        Click="MaximizeButton_Click">
                    <FontIcon x:Name="MaximizeGlyph"
                              Glyph="&#xE922;"
                              FontSize="10"/>
                </Button>
                <Button x:Name="CloseButton"
                        Style="{StaticResource CloseCaptionButtonStyle}"
                        Click="CloseButton_Click">
                    <FontIcon x:Name="CloseGlyph"
                              Glyph="&#xE8BB;"
                              FontSize="10"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 头部 -->
        <Border Grid.Row="1"
                Margin="10,6,10,0"
                Background="{StaticResource MicaPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="16">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="12">
                    <Image Width="38" Height="38"
                           Source="Assets/AppIcon.png"
                           Stretch="Uniform"/>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="局域网设备助手" FontSize="18"/>
                        <TextBlock Text="小米路由器设备状态与提醒"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="14"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="8"
                            Margin="0,0,18,0">
                    <Ellipse x:Name="ConnectionDot"
                             Width="8" Height="8"
                             Fill="#9CA3AF"/>
                    <TextBlock x:Name="ConnectionStatusText"
                               Text="尚未连接"
                               Foreground="{StaticResource MutedTextBrush}"/>
                    <Border Width="1" Height="20"
                            Background="{StaticResource BorderBrush}"
                            Margin="5,0"/>
                    <TextBlock x:Name="LastRefreshText"
                               Text="等待刷新"
                               Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="8">
                    <Button Style="{StaticResource QuietButtonStyle}"
                            Height="32" Padding="12,4"
                            Click="RouterButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE8CE;" FontSize="14"/>
                            <TextBlock Text="路由器"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource QuietButtonStyle}"
                            Height="32" Padding="12,4"
                            Click="SettingsButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE713;" FontSize="14"/>
                            <TextBlock Text="设置"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 内容 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="370"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="10,10,5,10"
                    Background="{StaticResource MicaPanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="6,8,6,10">
                        <Border x:Name="OnlineFilterCard"
                                Style="{StaticResource FilterCardStyle}"
                                Background="{StaticResource OnlineCardBrush}"
                                BorderBrush="{StaticResource OnlineCardBorderBrush}"
                                Tapped="OnlineFilterCard_Tapped">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock x:Name="OnlineCountText" Text="0" FontSize="14"/>
                                <TextBlock Text="在线" FontSize="13"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="OfflineFilterCard"
                                Style="{StaticResource FilterCardStyle}"
                                Background="{StaticResource OfflineCardBrush}"
                                BorderBrush="{StaticResource OfflineCardBorderBrush}"
                                Tapped="OfflineFilterCard_Tapped">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock x:Name="OfflineCountText" Text="0" FontSize="14"/>
                                <TextBlock Text="离线" FontSize="13"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <ListView x:Name="DeviceList"
                              Grid.Row="2"
                              SelectionChanged="DeviceList_SelectionChanged"
                              ItemContainerStyle="{StaticResource DeviceItemContainerStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:DeviceItemViewModel">
                                <Grid Padding="0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="42" Height="42"
                                            CornerRadius="10"
                                            Background="{StaticResource DeviceIconBrush}">
                                        <TextBlock Text="{x:Bind IconGlyph}"
                                                   FontFamily="Segoe Fluent Icons"
                                                   FontSize="21"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1"
                                                Margin="11,0,8,0"
                                                VerticalAlignment="Center"
                                                Spacing="2">
                                        <TextBlock Text="{x:Bind DisplayName}"
                                                   FontSize="14"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind ConnectionText}"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="14"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Right">
                                        <Border Width="48" Height="22"
                                                CornerRadius="11"
                                                Background="{StaticResource StatusOfflineBrush}">
                                            <TextBlock Text="{x:Bind StatusText}"
                                                       FontSize="13"
                                                       Foreground="{StaticResource StatusOfflineTextBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{x:Bind DownloadSpeedText}"
                                                   FontSize="14"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Margin="0,4,0,0"
                                                   HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Margin="5,10,10,10"
                    Background="{StaticResource MicaCardBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                <Grid Margin="24">
                    <StackPanel x:Name="DetailPanel"
                                Spacing="10"
                                Visibility="Visible">
                        <TextBlock x:Name="DetailTitle"
                                   FontSize="22"
                                   Text="选择设备以查看详情"/>
                        <TextBlock x:Name="DetailIpText"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="14"/>
                        <TextBlock x:Name="DetailStatusText"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="14"/>
                        <TextBlock x:Name="DetailSpeedText"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="14"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
