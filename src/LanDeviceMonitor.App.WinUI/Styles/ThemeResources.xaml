<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 基础画刷（浅色默认值，运行时按主题切换） -->
    <SolidColorBrush x:Key="AccentBrush" Color="#4D7EF2"/>
    <SolidColorBrush x:Key="MicaPanelBrush" Color="#0CFFFFFF"/>
    <SolidColorBrush x:Key="MicaCardBrush" Color="#70FFFFFF"/>
    <SolidColorBrush x:Key="DeviceIconBrush" Color="#76EDF3FF"/>
    <SolidColorBrush x:Key="TextBrush" Color="#182034"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#667087"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#9AD4D4D4"/>
    <SolidColorBrush x:Key="ControlBrush" Color="#B8FFFFFF"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#DCFFFFFF"/>
    <SolidColorBrush x:Key="QuietControlBrush" Color="#B0F5F5F5"/>
    <SolidColorBrush x:Key="CaptionHoverBrush" Color="#2B000000"/>
    <SolidColorBrush x:Key="CaptionPressedBrush" Color="#3D000000"/>
    <SolidColorBrush x:Key="CloseHoverBrush" Color="#FF525C"/>
    <SolidColorBrush x:Key="ListItemBrush" Color="#98FFFFFF"/>
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="#C0FFFFFF"/>
    <SolidColorBrush x:Key="DeviceListItemBrush" Color="#99FFFFFF"/>
    <SolidColorBrush x:Key="DeviceListItemSelectedBrush" Color="#C0FFFFFF"/>
    <SolidColorBrush x:Key="DeviceListItemHoverBrush" Color="#BFFFFFFF"/>
    <SolidColorBrush x:Key="OnlineCardBrush" Color="#84D9F8E6"/>
    <SolidColorBrush x:Key="OnlineCardBorderBrush" Color="#704CC88A"/>
    <SolidColorBrush x:Key="OfflineCardBrush" Color="#84FFEAEA"/>
    <SolidColorBrush x:Key="OfflineCardBorderBrush" Color="#40E36C6C"/>
    <SolidColorBrush x:Key="StatusOnlineBrush" Color="#A8DDF5E8"/>
    <SolidColorBrush x:Key="StatusOfflineBrush" Color="#A8FCE8E8"/>
    <SolidColorBrush x:Key="StatusOnlineTextBrush" Color="#14794A"/>
    <SolidColorBrush x:Key="StatusOfflineTextBrush" Color="#B64141"/>

    <!-- 标题栏按钮 -->
    <Style x:Key="CaptionButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Grid x:Name="HoverSurface"
                              Background="{StaticResource CaptionHoverBrush}"
                              Opacity="0"/>
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverSurface"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.15"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames
                                            Storyboard.TargetName="HoverSurface"
                                            Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame
                                                KeyTime="0"
                                                Value="{StaticResource CaptionPressedBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseCaptionButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource CaptionButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Grid x:Name="HoverSurface"
                              Background="{StaticResource CloseHoverBrush}"
                              Opacity="0"/>
                        <ContentPresenter x:Name="Content"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverSurface"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.15"/>
                                        <ObjectAnimationUsingKeyFrames
                                            Storyboard.TargetName="Content"
                                            Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame
                                                KeyTime="0"
                                                Value="White"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverSurface"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.82"
                                                         Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 普通按钮 -->
    <Style x:Key="QuietButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource QuietControlBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames
                                            Storyboard.TargetName="Surface"
                                            Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame
                                                KeyTime="0"
                                                Value="{StaticResource ControlHoverBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 在线/离线统计卡 -->
    <Style x:Key="FilterCardStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,6"/>
    </Style>

    <!-- 设备列表项 -->
    <Style x:Key="DeviceItemContainerStyle" TargetType="ListViewItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,7"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="11"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Grid>
                        <Border x:Name="ItemBorder"
                                Background="{StaticResource DeviceListItemBrush}"
                                CornerRadius="11"/>
                        <Border x:Name="StateBorder"
                                Background="{StaticResource DeviceListItemSelectedBrush}"
                                CornerRadius="11"
                                Opacity="0"/>
                        <ContentPresenter Margin="10,0"/>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames
                                            Storyboard.TargetName="StateBorder"
                                            Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame
                                                KeyTime="0"
                                                Value="{StaticResource DeviceListItemHoverBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="StateBorder"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.15"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="StateBorder"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="SelectedPointerOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="StateBorder"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
